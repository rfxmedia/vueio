# Generated automatically by `vueioctl install`. Keep the real file private.
# Replace this example value with the immutable release being installed.
VUEIO_VERSION=v0.0.0-alpha.0
VUEIO_COMPOSE_PROJECT=vueio
VUEIO_UI_PORT=9000
VUEIO_BIND_ADDRESS=127.0.0.1
VUEIO_DATA_PATH=/opt/vueio/data
VUEIO_PUID=1000
VUEIO_PGID=1000
VUEIO_UMASK=0027
VUEIO_PROJECT_DIRECTORY_MODE=0775
VUEIO_PROJECT_FILE_MODE=0664
VUEIO_UPLOAD_MAX_FILES_PER_SESSION=10000
VUEIO_UPLOAD_MAX_FILE_BYTES=107374182400
VUEIO_UPLOAD_MAX_SESSION_BYTES=536870912000
VUEIO_UPLOAD_MIN_FREE_BYTES=21474836480
VUEIO_DATA_MIN_FREE_BYTES=21474836480
# Maximum bytes used by completed MP4/HLS preview artifacts. Set 0 for no cap.
VUEIO_TRANSCODE_CACHE_MAX_BYTES=268435456000
VUEIO_PUBLIC_UPLOAD_MAX_ACTIVE_SESSIONS=25
VUEIO_PUBLIC_UPLOAD_MAX_ACTIVE_SESSIONS_PER_CLIENT=5
VUEIO_PUBLIC_UPLOAD_MAX_FILES_PER_SESSION=2000
VUEIO_PUBLIC_UPLOAD_MAX_SHARE_BYTES=1099511627776
VUEIO_PUBLIC_UPLOAD_CREATE_RATE_LIMIT=20/hour
VUEIO_PUBLIC_UPLOAD_CHUNK_RATE_LIMIT=240/minute
VUEIO_PUBLIC_COMMENT_CREATE_RATE_LIMIT=60/hour
VUEIO_PUBLIC_COMMENT_BATCH_RATE_LIMIT=240/minute
VUEIO_PUBLIC_SHARE_PASSWORD_RATE_LIMIT=30/minute
VUEIO_COMMENT_ATTACHMENT_MAX_FILE_BYTES=268435456
VUEIO_COMMENT_ATTACHMENT_MAX_TOTAL_BYTES=524288000
VUEIO_COMMENT_ANNOTATION_MAX_BYTES=2097152
# Voice notes are transcribed locally by the Vue.io engine.
VUEIO_VOICE_TRANSCRIPTION_ENABLED=true

VUEIO_POSTGRES_DB=vueio
VUEIO_POSTGRES_USER=vueio
VUEIO_POSTGRES_PASSWORD=generated-during-install
VUEIO_POSTGRES_VOLUME=vueio_postgres_data
VUEIO_SECRET_KEY=generated-during-install
VUEIO_SETUP_TOKEN=generated-during-install

# Local bootstrap mode is intentionally bound to loopback. Use
# `vueioctl exposure set https://vue.example.com` before exposing it.
VUEIO_APP_ENV=production
VUEIO_LOCAL_HTTP=true
VUEIO_SESSION_COOKIE_SECURE=false
VUEIO_CORS_ALLOW_ORIGINS=http://127.0.0.1:9000
VUEIO_PUBLIC_BASE_URL=
VUEIO_TRUST_CLOUDFLARE=false
VUEIO_TRUST_UPSTREAM_PROXY=false

# Generated by `vueioctl storage add`; do not hand-edit unless stopped.
VUEIO_PROJECT_STORAGE_ROOTS=
VUEIO_ENGINE_REPOSITORY=ghcr.io/rfxmedia/vueio-engine
VUEIO_UI_REPOSITORY=ghcr.io/rfxmedia/vueio-ui
VUEIO_RELEASE_ROOT_URL=https://github.com/rfxmedia/vueio/releases
VUEIO_UPDATE_REPOSITORY=rfxmedia/vueio
VUEIO_ENGINE_IMAGE=ghcr.io/rfxmedia/vueio-engine:v0.0.0-alpha.0
VUEIO_UI_IMAGE=ghcr.io/rfxmedia/vueio-ui:v0.0.0-alpha.0
