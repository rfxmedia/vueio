install_vueio() {
  if [[ $(uname -s) == Darwin && $(uname -m) != arm64 ]]; then
    die "The Mac preview needs Apple Silicon. Intel Macs are not supported."
  fi
  require_command docker
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required"
  docker info >/dev/null 2>&1 || die "Docker is installed but is not running"

  local source_compose source_license version channel port bind local_url puid pgid default_uid default_gid
  local initial_path initial_label initial_mode default_initial_path candidate state_path state_id default_state_path
  local drive_choice source_helper drive_number=0
  local -a drive_choices=()
  local compose_project postgres_volume
  local create_initial_path=false port_was_explicit=false
  source_compose=${VUEIO_RELEASE_COMPOSE:-"$SCRIPT_DIR/../compose.release.yml"}
  source_license=${VUEIO_RELEASE_LICENSE:-"$SCRIPT_DIR/../LICENSE.md"}
  version=${VUEIO_VERSION:-}
  validate_release_tag "$version"
  channel=${VUEIO_CHANNEL:-stable}
  if [[ -z ${VUEIO_CHANNEL:-} ]] && is_nightly_tag "$version"; then channel=nightly; fi
  validate_channel "$channel"
  if [[ $channel == stable ]] && is_nightly_tag "$version"; then
    die "A nightly release requires VUEIO_CHANNEL=nightly"
  fi
  [[ -f "$source_compose" ]] || die "compose.release.yml was not found beside this release"
  [[ -f "$source_license" ]] || die "LICENSE.md was not found beside this release"

  [[ -n ${VUEIO_UI_PORT:-} || -n ${VUEIO_LOCAL_URL:-} ]] && port_was_explicit=true
  port=${VUEIO_UI_PORT:-9000}
  bind=${VUEIO_BIND_ADDRESS:-127.0.0.1}
  validate_port "$port"
  if port_in_use "$port"; then
    if [[ $port_was_explicit == true ]]; then
      die "Port $port is already in use. Choose another with VUEIO_UI_PORT."
    fi
    for candidate in {9001..9010}; do
      if ! port_in_use "$candidate"; then
        warn "Port 9000 is busy, so Vueio will use port $candidate."
        port=$candidate
        break
      fi
    done
    port_in_use "$port" && die "Ports 9000 through 9010 are already in use. Set VUEIO_UI_PORT to an available port."
  fi
  default_uid=$(id -u)
  default_gid=$(id -g)
  if [[ $default_uid == 0 ]]; then
    default_uid=1000
    default_gid=1000
  fi
  if [[ $(uname -s) == Darwin ]]; then
    puid=${VUEIO_PUID:-$default_uid}
    pgid=${VUEIO_PGID:-$default_gid}
  else
    puid=${VUEIO_PUID:-${SUDO_UID:-$default_uid}}
    pgid=${VUEIO_PGID:-${SUDO_GID:-$default_gid}}
  fi
  [[ $puid =~ ^[0-9]+$ && $pgid =~ ^[0-9]+$ ]] || die "PUID and PGID must be numeric"
  local_url=${VUEIO_LOCAL_URL:-http://127.0.0.1:$port}
  compose_project=${VUEIO_COMPOSE_PROJECT:-vueio}
  postgres_volume=${VUEIO_POSTGRES_VOLUME:-${compose_project}_postgres_data}
  [[ $compose_project =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]] ||
    die "VUEIO_COMPOSE_PROJECT contains unsupported characters"

  source_helper=${VUEIO_RELEASE_UPDATER:-"$SCRIPT_DIR/vueio-updater.py"}
  default_state_path=${VUEIO_STATE_PATH:-$VUEIO_HOME/state}
  state_path=$default_state_path
  screen "SETUP · 2 / 5" "Where should Vueio keep its data?"
  note "  Accounts, projects, comments and history live here."
  note "  Keep this folder connected. Back up your data."
  printf '\n'
  if [[ ${VUEIO_NONINTERACTIVE:-0} != 1 ]]; then
    option 0 "Default folder (recommended)" "$default_state_path"
    mapfile -t drive_choices < <(python3 "$source_helper" --home "$VUEIO_HOME" --list-drives data 2>/dev/null || true)
    for candidate in "${drive_choices[@]}"; do
      drive_number=$((drive_number + 1))
      option "$drive_number" "${candidate##*/}" "$candidate"
    done
    choose_hint
  fi
  while true; do
    if [[ ${VUEIO_NONINTERACTIVE:-0} != 1 ]]; then
      printf '\n  %sData folder [0] ›%s ' "$MINT" "$RESET"
      read -r candidate || { note "Setup cancelled. Nothing was installed."; return 0; }
      if [[ $candidate == q ]]; then note "Setup cancelled. Nothing was installed."; return 0
      elif [[ $candidate == '?' ]]; then
        note "The data folder also holds app files, previews and database backups."
        note "Use internal storage if possible. Copy backups to another drive."
        note "An external data drive must stay connected while Vueio runs."
        continue
      elif [[ -z $candidate || $candidate == 0 ]]; then
        state_path=$default_state_path
      elif [[ $candidate =~ ^[1-9][0-9]{0,2}$ ]]; then
        if ((candidate > ${#drive_choices[@]})); then warn "That drive number is not listed."; continue; fi
        state_path="${drive_choices[$((candidate - 1))]}/Vueio data"
        printf 'Folder on this drive [%s]: ' "$state_path"
        read -r candidate || { note "Setup cancelled. Nothing was installed."; return 0; }
        [[ $candidate != q ]] || { note "Setup cancelled. Nothing was installed."; return 0; }
        state_path=${candidate:-$state_path}
      else
        state_path=${candidate:-$state_path}
      fi
    fi
    if candidate=$(python3 "$source_helper" --home "$VUEIO_HOME" --data-folder "$state_path"); then
      state_path=$candidate
      break
    fi
    [[ ${VUEIO_NONINTERACTIVE:-0} != 1 ]] || die "Choose a suitable VUEIO_STATE_PATH."
  done
  # Media must never expose the selected database or its enclosing directory.
  VUEIO_INSTALL_STATE_PATH=$state_path
  if paths_overlap "$state_path" "$(realpath -m "$VUEIO_HOME")" && [[ $state_path != "$(realpath -m "$VUEIO_HOME")/state" ]]; then
    die "Choose a separate data folder, or use the default $VUEIO_HOME/state. Do not place data over the private configuration."
  fi
  state_id=$(random_hex 24)
  BACKUP_DIR="$state_path/backups"

  if [[ $(uname -s) == Darwin ]]; then
    default_initial_path=${VUEIO_DEFAULT_STORAGE_PATH:-"$HOME/Movies/Vueio projects"}
  else
    default_initial_path=${VUEIO_DEFAULT_STORAGE_PATH:-/var/lib/vueio/projects}
  fi
  initial_path=${VUEIO_INITIAL_STORAGE_PATH:-}
  initial_label=${VUEIO_INITIAL_STORAGE_LABEL:-Projects}
  initial_mode=${VUEIO_INITIAL_STORAGE_MODE:-rw}
  if [[ -z $initial_path && ${VUEIO_NONINTERACTIVE:-0} != 1 ]]; then
    screen "SETUP · 3 / 5" "Where are your media files?"
    note "  Use a folder on this computer or a connected drive."
    note "  No drive is erased. Add more drives later in Settings."
    printf '\n'
    option 0 "This computer" "$default_initial_path"
    source_helper=${VUEIO_RELEASE_UPDATER:-"$SCRIPT_DIR/vueio-updater.py"}
    if [[ -f $source_helper ]]; then
      drive_choices=()
      drive_number=0
      while IFS= read -r candidate; do
        paths_overlap "$candidate" "$state_path" || drive_choices+=("$candidate")
      done < <(python3 "$source_helper" --home "$VUEIO_HOME" --list-drives 2>/dev/null || true)
      for candidate in "${drive_choices[@]}"; do
        drive_number=$((drive_number + 1))
        option "$drive_number" "${candidate##*/}" "$candidate"
      done
    fi
    choose_hint
    while true; do
      printf '\n  %sMedia folder [0] ›%s ' "$MINT" "$RESET"
      read -r drive_choice || { note "Setup cancelled. Nothing was installed."; return 0; }
      if [[ $drive_choice == q ]]; then note "Setup cancelled. Nothing was installed."; return 0
      elif [[ $drive_choice == '?' ]]; then
        note "Only the selected folder is connected. Existing files stay in place."
        note "Keep media separate from your Vue data folder."
        continue
      elif [[ -z $drive_choice || $drive_choice == 0 ]]; then
        initial_path=$default_initial_path
      elif [[ $drive_choice =~ ^[1-9][0-9]{0,2}$ ]]; then
        if ((drive_choice > ${#drive_choices[@]})); then
          warn "That drive number is not listed. Press Enter to use this computer."
          continue
        fi
        initial_path=${drive_choices[$((drive_choice - 1))]}
      else
        initial_path=$drive_choice
      fi
      if [[ $initial_path != "$default_initial_path" && ! -d $initial_path ]]; then
        warn "That folder was not found. Check the path, or press Enter to use this computer."
        continue
      fi
      break
    done
  elif [[ -z $initial_path ]]; then
    die "Set VUEIO_INITIAL_STORAGE_PATH for a non-interactive installation"
  fi
  validate_label "$initial_label"
  validate_mode "$initial_mode"
  if [[ -d $initial_path ]]; then
    initial_path=$(realpath "$initial_path")
  elif [[ $initial_path == "$default_initial_path" && ${VUEIO_NONINTERACTIVE:-0} != 1 ]]; then
    initial_path=$(realpath -m "$initial_path")
    create_initial_path=true
  else
    die "Storage folder does not exist: $initial_path. Create or mount it first, then run the installer again."
  fi
  validate_storage_path "$initial_path"

  if [[ -f "$VUEIO_HOME/.installing" && ! -f "$VUEIO_HOME/.installed" ]]; then
    [[ -z $(env_value VUEIO_STATE_PATH 2>/dev/null || true) ]] ||
      die "An incomplete installation has a separate data folder. Its configuration and data were kept for recovery. Inspect it before retrying; it will not be erased automatically."
    grep -qx 'vueio-install-v1' "$VUEIO_HOME/.installing" ||
      die "Unrecognized incomplete-install marker in $VUEIO_HOME; refusing to remove that directory"
    warn "Removing an incomplete prior installation before retrying."
    if [[ -f $ENV_FILE && -f $COMPOSE_FILE && -f $STORAGE_COMPOSE_FILE ]]; then
      # This volume belongs only to a setup that never reached `.installed`.
      # Leaving it behind makes the safety preflight reject every retry.
      compose down -v --remove-orphans ||
        die "Could not remove the incomplete installation's Docker resources; $VUEIO_HOME was preserved"
    fi
    rm -rf -- "$VUEIO_HOME"
  fi
  [[ ! -e "$ENV_FILE" ]] || die "An installation already exists in $VUEIO_HOME"
  if [[ -d $VUEIO_HOME ]] && find "$VUEIO_HOME" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
    die "Installation directory is not empty: $VUEIO_HOME"
  fi
  if docker ps -aq --filter "label=com.docker.compose.project=$compose_project" | grep -q . ||
    docker network ls -q --filter "label=com.docker.compose.project=$compose_project" | grep -q . ||
    docker volume inspect "$postgres_volume" >/dev/null 2>&1; then
    die "Docker resources already exist for project '$compose_project'. Choose a unique VUEIO_COMPOSE_PROJECT instead of risking another installation."
  fi

  if [[ ${VUEIO_NONINTERACTIVE:-0} != 1 ]]; then
    screen "SETUP · 4 / 5" "Ready to install"
    option "" "Vue data" "$state_path"
    option "" "Media files" "$initial_path"
    option "" "Browser address" "$local_url"
    note "  Release: $version · $channel"
    note "  Existing media stays in place."
    printf '\n'
    confirm "  Install Vueio?" || {
      note "Installation cancelled. Nothing was changed."
      return 0
    }
  fi

  title "  Installing"
  step "Prepare data and storage"
  mkdir -p "$VUEIO_HOME" "$STORAGE_DIR" "$LOG_DIR"
  printf 'vueio-install-v1\n' >"$VUEIO_HOME/.installing"
  # EXIT traps run after Bash has released function-local variables.
  VUEIO_INSTALL_RESOURCES_MAY_EXIST=false
  VUEIO_INSTALL_IN_PROGRESS=true
  VUEIO_INSTALL_CREATED_STORAGE_MARKER=
  VUEIO_INSTALL_CREATED_STORAGE_SENTINEL=
  VUEIO_INSTALL_CREATED_STORAGE_DIR=
  cleanup_failed_install() {
    local status=$? marker_value='' resources_removed=true
    trap - EXIT INT TERM
    set +e
    if [[ -f "$VUEIO_HOME/.installing" ]]; then
      if [[ $VUEIO_INSTALL_RESOURCES_MAY_EXIST == true && -f $ENV_FILE && -f $COMPOSE_FILE && -f $STORAGE_COMPOSE_FILE ]]; then
        compose down -v --remove-orphans >/dev/null 2>&1 || resources_removed=false
      fi
      if [[ $resources_removed != true ]]; then
        warn "Docker cleanup failed; incomplete state was preserved in $VUEIO_HOME for a safe retry."
        exit "$status"
      fi
      if [[ -n $(env_value VUEIO_STATE_PATH 2>/dev/null) ]]; then
        warn "Setup did not finish. Vue data and private configuration were kept at the locations you chose. No database or media was deleted."
        exit "$status"
      fi
      if [[ -n ${VUEIO_INSTALL_CREATED_STORAGE_MARKER:-} &&
        -n ${VUEIO_INSTALL_CREATED_STORAGE_SENTINEL:-} &&
        -f $VUEIO_INSTALL_CREATED_STORAGE_MARKER &&
        ! -L $VUEIO_INSTALL_CREATED_STORAGE_MARKER ]]; then
        marker_value=$(
          dd if="$VUEIO_INSTALL_CREATED_STORAGE_MARKER" iflag=nofollow,nonblock bs=256 count=1 status=none 2>/dev/null
        ) || marker_value=
        if [[ $marker_value == "$VUEIO_INSTALL_CREATED_STORAGE_SENTINEL" ]]; then
          rm -f -- "$VUEIO_INSTALL_CREATED_STORAGE_MARKER"
        fi
      fi
      if [[ -n ${VUEIO_INSTALL_CREATED_STORAGE_DIR:-} ]]; then
        rmdir -- "$VUEIO_INSTALL_CREATED_STORAGE_DIR" 2>/dev/null || true
      fi
      rm -rf -- "$VUEIO_HOME"
      warn "Incomplete installation state was removed. Run '$PROGRAM install' to retry."
    fi
    exit "$status"
  }
  trap cleanup_failed_install EXIT INT TERM

  cp "$source_compose" "$COMPOSE_FILE"
  install -m 0644 "$source_license" "$LICENSE_FILE"
  cat >"$ENV_FILE" <<EOF
VUEIO_VERSION=$version
VUEIO_CHANNEL=$channel
VUEIO_COMPOSE_PROJECT=$compose_project
VUEIO_UI_PORT=$port
VUEIO_BIND_ADDRESS=$bind
VUEIO_HOME_PATH=$VUEIO_HOME
VUEIO_STATE_PATH=$state_path
VUEIO_STATE_ID=$state_id
VUEIO_DATABASE_INITIALIZING=true
VUEIO_DATA_PATH=$state_path/app
VUEIO_PUID=$puid
VUEIO_PGID=$pgid
VUEIO_UMASK=${VUEIO_UMASK:-0027}
VUEIO_PROJECT_DIRECTORY_MODE=${VUEIO_PROJECT_DIRECTORY_MODE:-0775}
VUEIO_PROJECT_FILE_MODE=${VUEIO_PROJECT_FILE_MODE:-0664}
VUEIO_UPLOAD_MAX_FILE_BYTES=${VUEIO_UPLOAD_MAX_FILE_BYTES:-107374182400}
VUEIO_UPLOAD_MAX_SESSION_BYTES=${VUEIO_UPLOAD_MAX_SESSION_BYTES:-536870912000}
VUEIO_UPLOAD_MIN_FREE_BYTES=${VUEIO_UPLOAD_MIN_FREE_BYTES:-21474836480}
VUEIO_DATA_MIN_FREE_BYTES=${VUEIO_DATA_MIN_FREE_BYTES:-21474836480}
VUEIO_TRANSCODE_CACHE_MAX_BYTES=${VUEIO_TRANSCODE_CACHE_MAX_BYTES:-268435456000}
VUEIO_POSTGRES_DB=vueio
VUEIO_POSTGRES_USER=vueio
VUEIO_POSTGRES_PASSWORD=$(random_hex 32)
VUEIO_POSTGRES_VOLUME=$postgres_volume
VUEIO_SECRET_KEY=$(random_hex 48)
VUEIO_SETUP_TOKEN=$(random_hex 24)
VUEIO_APP_ENV=production
VUEIO_LOCAL_HTTP=true
VUEIO_SESSION_COOKIE_SECURE=false
VUEIO_CORS_ALLOW_ORIGINS=$local_url
VUEIO_PUBLIC_BASE_URL=
VUEIO_TRUST_CLOUDFLARE=false
VUEIO_TRUST_UPSTREAM_PROXY=false
VUEIO_PROJECT_STORAGE_ROOTS={}
VUEIO_ENGINE_REPOSITORY=${VUEIO_ENGINE_REPOSITORY:-ghcr.io/rfxmedia/vueio-engine}
VUEIO_UI_REPOSITORY=${VUEIO_UI_REPOSITORY:-ghcr.io/rfxmedia/vueio-ui}
VUEIO_RELEASE_ROOT_URL=${VUEIO_RELEASE_ROOT_URL:-https://github.com/rfxmedia/vueio/releases}
VUEIO_UPDATE_REPOSITORY=${VUEIO_UPDATE_REPOSITORY:-rfxmedia/vueio}
VUEIO_ENGINE_IMAGE=${VUEIO_ENGINE_IMAGE:-${VUEIO_ENGINE_REPOSITORY:-ghcr.io/rfxmedia/vueio-engine}:$version}
VUEIO_UI_IMAGE=${VUEIO_UI_IMAGE:-${VUEIO_UI_REPOSITORY:-ghcr.io/rfxmedia/vueio-ui}:$version}
EOF
  chmod 600 "$ENV_FILE"
  chmod 700 "$VUEIO_HOME" "$STORAGE_DIR" "$LOG_DIR"
  # Recheck after the confirmation, immediately before creating anything.
  python3 "$source_helper" --home "$VUEIO_HOME" --data-folder "$state_path" >/dev/null ||
    die "The data folder changed during setup. Nothing in it was overwritten."
  mkdir -p "$state_path/postgres" "$state_path/app" "$BACKUP_DIR"
  (set -o noclobber; printf '%s\n' "$state_id" >"$state_path/.vueio-storage-id")
  chmod 444 "$state_path/.vueio-storage-id"
  chmod 700 "$state_path/postgres" "$BACKUP_DIR"
  # PostgreSQL and the media engine have different UIDs. Permit traversal of
  # this parent only; each child keeps its own private permissions.
  chmod 711 "$state_path"
  chmod 750 "$state_path/app"
  chown "$(id -u):$pgid" "$state_path"
  render_data_mount
  prepare_updater_directory
  if [[ -f ${VUEIO_RELEASE_UPDATER:-"$SCRIPT_DIR/vueio-updater.py"} ]]; then
    install -m 0644 "${VUEIO_RELEASE_UPDATER:-"$SCRIPT_DIR/vueio-updater.py"}" "$UPDATER_FILE"
  fi
  local media_helper
  media_helper="$(dirname "$source_helper")/vueio-media.py"
  if [[ ! -f $media_helper && -f $SCRIPT_DIR/../backend/app/services/media_encoding.py ]]; then
    media_helper="$SCRIPT_DIR/../backend/app/services/media_encoding.py"
  fi
  [[ ! -f $media_helper ]] || install -m 0644 "$media_helper" "$VUEIO_HOME/vueio-media.py"
  chown "$puid:$pgid" "$state_path/app" 2>/dev/null ||
    warn "Could not set data ownership to $puid:$pgid; verify it with '$PROGRAM doctor'"
  render_storage

  if [[ $create_initial_path == true ]]; then
    mkdir -p -- "$initial_path"
    chown "$puid:$pgid" "$initial_path" 2>/dev/null ||
      warn "Could not set project storage ownership to $puid:$pgid"
    VUEIO_INSTALL_CREATED_STORAGE_DIR=$initial_path
    success "Created project storage at $initial_path"
  fi

  storage_add "$initial_label" "$initial_path" "$initial_mode"
  render_gpu_access

  if [[ ${VUEIO_SKIP_START:-0} != 1 ]]; then
    if [[ ${VUEIO_SKIP_PULL:-0} != 1 ]]; then
      step "Download Vueio · This can take several minutes"
      compose pull >"$LOG_DIR/install-download.log" 2>&1 ||
        die "Download failed. Details: $LOG_DIR/install-download.log"
      success "Download complete"
    fi
    VUEIO_INSTALL_RESOURCES_MAY_EXIST=true
    step "Start Vueio · This can take a minute"
    compose up -d >"$LOG_DIR/install-start.log" 2>&1 ||
      die "Vueio could not start. Details: $LOG_DIR/install-start.log"
    success "Services started"
    step "Check data, storage and website"
    if ! doctor >"$LOG_DIR/install-checks.log" 2>&1; then
      die "Checks failed. Data was kept. Details: $LOG_DIR/install-checks.log"
    fi
    success "Database, storage access and website checks passed"
    # Subsequent boots must find an existing database, even if only its files
    # (rather than the whole data drive) have gone missing.
    step "Finish database setup"
    set_env VUEIO_DATABASE_INITIALIZING false
    compose up -d vueio_postgres vueio_engine vueio_ui >"$LOG_DIR/install-finish.log" 2>&1 ||
      die "Setup could not finish. Details: $LOG_DIR/install-finish.log"
    wait_for_engine || die "The database could not restart with its initialization guard enabled."
  fi
  printf 'vueio-install-v1\n' >"$VUEIO_HOME/.installed"
  rm -f "$VUEIO_HOME/.installing"
  VUEIO_INSTALL_IN_PROGRESS=false
  VUEIO_INSTALL_CREATED_STORAGE_MARKER=
  VUEIO_INSTALL_CREATED_STORAGE_SENTINEL=
  VUEIO_INSTALL_CREATED_STORAGE_DIR=
  trap - EXIT INT TERM
  if [[ ${VUEIO_DEFER_SETUP_INFO:-0} != 1 ]]; then show_setup_info; fi
}

doctor() {
  require_installed
  local fix=false local_http data_path puid pgid id label mode path sentinel marker ui_ready=false
  local version channel engine_image ui_image expected_engine expected_ui probe available_kb
  local -a issues=()
  case ${1:-} in
    '') ;;
    --fix) fix=true ;;
    *) die "Usage: $PROGRAM doctor [--fix]" ;;
  esac

  version=$(env_value VUEIO_VERSION)
  channel=$(env_value VUEIO_CHANNEL)
  channel=${channel:-stable}
  if [[ $fix == true ]]; then
    [[ ! -f $UPDATE_STATE_FILE ]] ||
      die "An interrupted update needs review first. Use '$PROGRAM rollback' only after reviewing the recovery backup."
    note "Applying safe repairs..."
    find "$VUEIO_HOME" -maxdepth 1 -type d \
      \( -name '.update.*' -o -name '.release-check.*' \) \
      -exec rm -rf -- {} +
    if [[ -z $(env_value VUEIO_CHANNEL) ]]; then
      set_env VUEIO_CHANNEL stable
      channel=stable
    fi
    if [[ $version =~ $RELEASE_TAG_PATTERN ]]; then
      expected_engine="$(env_value VUEIO_ENGINE_REPOSITORY):$version"
      expected_ui="$(env_value VUEIO_UI_REPOSITORY):$version"
      set_env VUEIO_ENGINE_IMAGE "$expected_engine"
      set_env VUEIO_UI_IMAGE "$expected_ui"
    fi
    mkdir -p "$BACKUP_DIR" "$LOG_DIR"
    chmod 700 "$BACKUP_DIR" "$LOG_DIR"
    compose up -d
  fi

  note "Vueio release: $(env_value VUEIO_VERSION)"
  note "Update channel: $channel"
  note "Configured origin: $(env_value VUEIO_CORS_ALLOW_ORIGINS)"
  note "Checking Docker configuration..."
  if ! compose config -q; then
    issues+=("Fix the Docker Compose configuration, then run '$PROGRAM doctor' again.")
  fi

  if [[ ! $version =~ $RELEASE_TAG_PATTERN ]]; then
    warn "Installed release tag is invalid: $version"
    issues+=("Restore VUEIO_VERSION to the exact release tag that is installed.")
  fi
  if [[ $channel != stable && $channel != nightly ]]; then
    warn "Update channel is invalid: $channel"
    issues+=("Run '$PROGRAM channel stable' or '$PROGRAM channel nightly'.")
  fi

  engine_image=$(env_value VUEIO_ENGINE_IMAGE)
  ui_image=$(env_value VUEIO_UI_IMAGE)
  expected_engine="$(env_value VUEIO_ENGINE_REPOSITORY):$version"
  expected_ui="$(env_value VUEIO_UI_REPOSITORY):$version"
  if [[ $engine_image != "$expected_engine" || $ui_image != "$expected_ui" ]]; then
    warn "Container image pins do not match the installed release"
    issues+=("Run '$PROGRAM doctor --fix' to reconcile the image pins safely.")
  else
    note "OK: container image pins match $version"
  fi

  if [[ -f $UPDATE_STATE_FILE && ${VUEIO_UPDATE_IN_PROGRESS:-0} != 1 ]]; then
    warn "An incomplete update state is present: $UPDATE_STATE_FILE"
    issues+=("Review the update log and recovery backup before using '$PROGRAM rollback'.")
  elif [[ -f $UPDATE_STATE_FILE ]]; then
    note "OK: the current update owns its recovery state"
  else
    note "OK: no partial update is waiting for recovery"
  fi

  if [[ -d $BACKUP_DIR ]] && probe=$(mktemp "$BACKUP_DIR/.write-test.XXXXXX" 2>/dev/null); then
    rm -f "$probe"
    note "OK: backup directory is writable"
  else
    warn "Backup directory is not writable: $BACKUP_DIR"
    issues+=("Correct the permissions on $BACKUP_DIR before updating or backing up.")
  fi
  if [[ -d $LOG_DIR ]] && probe=$(mktemp "$LOG_DIR/.write-test.XXXXXX" 2>/dev/null); then
    rm -f "$probe"
    note "OK: update log directory is writable"
  else
    warn "Update log directory is not writable: $LOG_DIR"
    issues+=("Correct the permissions on $LOG_DIR before updating.")
  fi
  available_kb=$(df -Pk "$VUEIO_HOME" | awk 'NR == 2 {print $4}')
  if ((available_kb >= 2 * 1024 * 1024)); then
    note "OK: at least 2 GiB of update headroom is available"
  else
    warn "Less than 2 GiB is free on the Vueio filesystem"
    issues+=("Free at least 2 GiB before downloading an update.")
  fi

  data_path=$(env_value VUEIO_DATA_PATH)
  puid=$(env_value VUEIO_PUID)
  pgid=$(env_value VUEIO_PGID)
  if [[ -d $data_path ]]; then
    note "OK: application data directory exists"
  else
    warn "Application data directory is missing: $data_path"
    issues+=("Restore or recreate the configured application data directory.")
  fi
  while IFS=$'\t' read -r id label path mode sentinel; do
    marker="$path/.vueio-storage-id"
    if [[ ! -d $path ]]; then
      warn "Storage '$label' is unavailable: $path"
      issues+=("Reconnect storage '$label' at $path.")
    elif [[ ! $sentinel =~ ^[a-f0-9]{32,128}$ ]]; then
      warn "Storage '$label' has no valid identity marker recorded; remove and re-add it after preparing $marker"
      issues+=("Remove and re-add storage '$label' after preparing its identity marker.")
    elif [[ -L $marker || ! -f $marker ]]; then
      warn "Storage '$label' is missing its regular identity marker: $marker"
      issues+=("Restore the identity marker for storage '$label'.")
    elif ! storage_marker_matches "$marker" "$sentinel"; then
      warn "Storage '$label' has the wrong mount identity; the expected filesystem may be disconnected"
      issues+=("Reconnect the expected filesystem for storage '$label'.")
    else
      note "OK: storage '$label' is available with the expected mount identity ($mode)"
    fi
  done < <(storage_records)

  local_http=$(env_value VUEIO_LOCAL_HTTP)
  if [[ $local_http == true ]]; then
    warn "Local HTTP bootstrap mode is enabled. Do not expose this port directly to the internet."
  else
    note "OK: secure-cookie/public URL mode is enabled"
  fi

  if compose ps --status running -q vueio_postgres 2>/dev/null | grep -q .; then
    if compose exec -T vueio_postgres pg_isready \
      -U "$(env_value VUEIO_POSTGRES_USER)" \
      -d "$(env_value VUEIO_POSTGRES_DB)" >/dev/null; then
      note "OK: PostgreSQL is responding"
    else
      warn "PostgreSQL is running but not ready"
      issues+=("Run '$PROGRAM doctor --fix' to restart unhealthy services.")
    fi
  else
    warn "PostgreSQL is not running"
    issues+=("Run '$PROGRAM doctor --fix' to start PostgreSQL.")
  fi

  if compose ps --status running -q vueio_engine 2>/dev/null | grep -q .; then
    if compose exec -T vueio_engine python -c \
      "import os,sys; sys.exit(0 if os.access('/app/data', os.R_OK | os.W_OK) else 1)"; then
      note "OK: engine user $puid:$pgid can read and write application data"
    else
      warn "Engine user $puid:$pgid cannot read and write application data"
      issues+=("Correct ownership or permissions on $data_path for $puid:$pgid.")
    fi
    while IFS=$'\t' read -r id label _ mode sentinel; do
      if compose exec -T vueio_engine python -c \
        "import os,sys; from pathlib import Path; p=Path('/storage/root-$id'); s='$sentinel'; m=p/'.vueio-storage-id'; ok=bool(s) and p.is_dir() and os.access(p, os.R_OK) and m.is_file() and not m.is_symlink() and m.read_text().rstrip('\\n')==s; sys.exit(0 if ok else 1)" </dev/null; then
        if [[ $mode == rw ]] && ! compose exec -T vueio_engine python -c \
          "import os,sys; sys.exit(0 if os.access('/storage/root-$id', os.W_OK) else 1)" </dev/null; then
          warn "Engine cannot write read/write storage '$label'"
          issues+=("Correct write access for storage '$label'.")
        else
          note "OK: engine can access storage '$label' as $mode"
        fi
      else
        warn "Engine cannot read storage '$label'"
        issues+=("Correct read access for storage '$label'.")
      fi
    done < <(storage_records)
  else
    warn "Vueio engine is not running; container permission checks were skipped"
    issues+=("Run '$PROGRAM doctor --fix' to restart the Vueio engine.")
  fi

  # A newly created UI container can briefly report "running" before Docker
  # accepts exec requests. Give first boot the same bounded readiness window as
  # the Compose health checks instead of treating that startup race as failure.
  for _ in {1..30}; do
    if compose ps --status running -q vueio_ui 2>/dev/null | grep -q . &&
      compose exec -T vueio_ui wget -qO- http://127.0.0.1:8080/api/setup/status >/dev/null 2>&1; then
      ui_ready=true
      break
    fi
    sleep 1
  done
  if [[ $ui_ready == true ]]; then
    note "OK: Vueio UI and API are responding"
  else
    warn "Vueio UI or API did not become ready"
    issues+=("Run '$PROGRAM doctor --fix', then inspect '$PROGRAM logs' if readiness still fails.")
  fi

  if ((${#issues[@]})); then
    warn "${#issues[@]} issue(s) need attention:"
    local issue_number=1 issue
    for issue in "${issues[@]}"; do
      printf '%d. %s\n' "$issue_number" "$issue" >&2
      issue_number=$((issue_number + 1))
    done
    die "Vueio needs attention"
  fi
  success "Everything looks healthy."
}

backup_manifest_value() {
  local archive=$1 key=$2
  tar -xOzf "$archive" ./manifest 2>/dev/null |
    sed -n "s/^${key}=//p" |
    tail -n 1
}

prune_backups() {
  local keep=${VUEIO_BACKUP_KEEP:-5} latest_pre_update='' archive kept=0
  local -a archives=()
  [[ $keep =~ ^[1-9][0-9]*$ ]] || die "VUEIO_BACKUP_KEEP must be a positive number"
  mapfile -t archives < <(
    find "$BACKUP_DIR" -maxdepth 1 -type f -name '*.tar.gz' -printf '%T@\t%p\n' |
      sort -rn |
      cut -f2-
  )
  for archive in "${archives[@]}"; do
    if [[ ${archive##*/} == pre-update-* ]]; then
      latest_pre_update=$archive
      break
    fi
  done
  for archive in "${archives[@]}"; do
    if ((kept < keep)) || [[ -n $latest_pre_update && $archive == "$latest_pre_update" ]]; then
      kept=$((kept + 1))
      continue
    fi
    rm -f -- "$archive" "$archive.sha256"
  done
}

list_backups() {
  require_installed
  local archive version created kind size found=false
  local -a archives=()
  mapfile -t archives < <(
    find "$BACKUP_DIR" -maxdepth 1 -type f -name '*.tar.gz' -printf '%T@\t%p\n' |
      sort -rn |
      cut -f2-
  )
  printf '%-18s  %-26s  %-12s  %9s\n' CREATED VERSION TYPE SIZE
  for archive in "${archives[@]}"; do
    version=$(backup_manifest_value "$archive" version)
    created=$(backup_manifest_value "$archive" created_at)
    kind=$(backup_manifest_value "$archive" kind)
    size=$(du -h "$archive" | awk '{print $1}')
    [[ -n $version && -n $created ]] || continue
    found=true
    printf '%-18s  %-26s  %-12s  %9s\n' "$created" "$version" "${kind:-manual}" "$size"
  done
  [[ $found == true ]] || note "(no backups available)"
}

database_size_bytes() {
  local bytes
  bytes=$(compose exec -T vueio_postgres psql -XAt -v ON_ERROR_STOP=1 \
    -U "$(env_value VUEIO_POSTGRES_USER)" -d "$(env_value VUEIO_POSTGRES_DB)" \
    -c 'SELECT pg_database_size(current_database())') || die "Could not measure the PostgreSQL database"
  [[ $bytes =~ ^[0-9]+$ ]] || die "PostgreSQL returned an invalid database size"
  printf '%s\n' "$bytes"
}

backup_vueio() (
  set -Eeuo pipefail
  umask 077
  require_installed
  local destination=${1:-} stamp tmp archive_tmp='' checksum_tmp='' was_running=false
  local database_bytes required_kb available_kb
  local kind=${VUEIO_BACKUP_KIND:-manual} target_version=${VUEIO_BACKUP_TARGET_VERSION:-}
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  destination=${destination:-"$BACKUP_DIR/vueio-$stamp.tar.gz"}
  [[ $destination = /* ]] || destination="$(pwd)/$destination"
  destination=$(realpath -m "$destination")
  [[ ! -d $destination ]] || die "Backup destination is a directory: $destination"
  [[ ! -e $destination && ! -e $destination.sha256 && ! -L $destination && ! -L $destination.sha256 ]] ||
    die "A backup already exists at this path. Choose a new filename; existing backups will not be overwritten."
  local media_path state_path
  while IFS=$'\t' read -r _ _ media_path _ _; do
    paths_overlap "$destination" "$media_path" && die "Keep database backups outside project media folders. They contain private account and project records."
  done < <(storage_records; storage_records removed)
  paths_overlap "$destination" "$(env_value VUEIO_DATA_PATH)" && die "Keep database backups outside the app's browsable files and previews."
  state_path=$(env_value VUEIO_STATE_PATH)
  if [[ -n $state_path ]] && paths_overlap "$destination" "$state_path/postgres"; then
    die "Do not put backup archives inside the live PostgreSQL directory."
  fi
  mkdir -p "$(dirname "$destination")"
  database_bytes=$(database_size_bytes)
  required_kb=$(((2 * database_bytes + 1023) / 1024 + 16384))
  for tmp in "$VUEIO_HOME" "$(dirname "$destination")"; do
    available_kb=$(df -Pk "$tmp" | awk 'NR == 2 {print $4}')
    ((available_kb > required_kb)) || die "Database backup needs about $((required_kb / 1024)) MiB free"
  done
  archive_tmp=$(mktemp "$(dirname "$destination")/.vueio-backup.XXXXXX")
  checksum_tmp=$(mktemp "$(dirname "$destination")/.vueio-checksum.XXXXXX") || {
    rm -f -- "$archive_tmp"
    die "Could not create the backup checksum"
  }
  tmp=$(mktemp -d "$VUEIO_HOME/.backup.XXXXXX") || {
    rm -f -- "$archive_tmp" "$checksum_tmp"
    die "Could not create backup staging"
  }
  trap 'rm -rf "$tmp"; rm -f -- "${archive_tmp:-}" "${checksum_tmp:-}"; if [[ $was_running == true ]]; then compose start vueio_engine >/dev/null 2>&1 || true; fi' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  if compose ps --status running -q vueio_engine 2>/dev/null | grep -q .; then
    was_running=true
    compose stop vueio_engine >/dev/null
  fi
  compose exec -T vueio_postgres pg_dump \
    -U "$(env_value VUEIO_POSTGRES_USER)" \
    -d "$(env_value VUEIO_POSTGRES_DB)" \
    -Fc >"$tmp/database.dump"
  [[ -s "$tmp/database.dump" ]] || die "PostgreSQL produced an empty backup"
  compose exec -T vueio_postgres pg_restore --list <"$tmp/database.dump" >/dev/null ||
    die "PostgreSQL backup validation failed"
  {
    printf 'format=2\n'
    printf 'created_at=%s\n' "$stamp"
    printf 'version=%s\n' "$(env_value VUEIO_VERSION)"
    printf 'kind=%s\n' "$kind"
    printf 'target_version=%s\n' "$target_version"
    printf 'scope=database\n'
  } >"$tmp/manifest"
  (
    cd "$tmp"
    sha256sum ./database.dump ./manifest >checksums.sha256
    # macOS otherwise adds AppleDouble files that are not database contents.
    COPYFILE_DISABLE=1 tar -czf "$archive_tmp" ./database.dump ./manifest ./checksums.sha256
  )
  printf '%s  %s\n' "$(sha256sum "$archive_tmp" | cut -d ' ' -f 1)" "$(basename "$destination")" >"$checksum_tmp"
  mv -f -- "$archive_tmp" "$destination"
  archive_tmp=
  mv -f -- "$checksum_tmp" "$destination.sha256"
  checksum_tmp=
  if [[ $was_running == true ]]; then
    if [[ ${VUEIO_BACKUP_LEAVE_ENGINE_STOPPED:-0} != 1 ]]; then
      compose start vueio_engine >/dev/null
      wait_for_engine || die "Vueio engine did not become ready after the backup"
    fi
    was_running=false
  fi
  trap - EXIT INT TERM
  rm -rf "$tmp"
  note "Database backup created: $destination"
  note "Checksum created: $destination.sha256"
  note "Application files, media, and existing backups are not included."
  case "$destination" in
    "$BACKUP_DIR"/*) prune_backups ;;
  esac
)

restore_vueio() (
  set -Eeuo pipefail
  umask 077
  require_installed
  require_command python3
  VUEIO_UPDATE_IN_PROGRESS=1
  export VUEIO_UPDATE_IN_PROGRESS
  local archive=${1:-} confirmation tmp safety safety_db stamp
  local engine_stopped=false db_restored=false environment_changed=false engine_was_running=false
  local previous_version previous_engine_image previous_ui_image
  [[ -f $archive ]] || die "Usage: $PROGRAM restore <archive.tar.gz>"
  note "This restores only the database. Current application files and media stay in place."
  if [[ ${VUEIO_NONINTERACTIVE:-0} != 1 ]]; then
    printf 'Replace the current database with this backup? Type RESTORE: '
    read -r confirmation
    [[ $confirmation == RESTORE ]] || return 0
  elif [[ ${VUEIO_RESTORE_CONFIRM:-} != RESTORE ]]; then
    die "Set VUEIO_RESTORE_CONFIRM=RESTORE for a non-interactive restore"
  fi

  archive=$(cd -P -- "$(dirname -- "$archive")" && pwd)/$(basename -- "$archive")
  tmp=$(mktemp -d "$VUEIO_HOME/.restore.XXXXXX")
  trap 'rm -rf "$tmp"; if [[ $engine_stopped == true && $engine_was_running == true ]]; then compose start vueio_engine >/dev/null 2>&1 || true; fi' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  [[ -f "$archive.sha256" ]] || warn "No adjacent archive checksum was found; validating internal contents only"
  # Validate every member/checksum, including legacy archives, but write only
  # the database and its two manifests. Never stage or replace application files.
  python3 - "$archive" "$tmp" <<'PY' || die "Backup archive or contents failed validation"
import hashlib
import hmac
import os
import pathlib
import posixpath
import re
import shutil
import sys
import tarfile

source, root = map(pathlib.Path, sys.argv[1:])
selected = {'database.dump', 'manifest', 'checksums.sha256'}
legacy_files = {'environment', 'compose.yml', 'compose.storage.yml', 'compose.installation.yml'}
seen = set()
hashes = {}
total_bytes = 0
member_count = 0


class DigestReader:
    def __init__(self, handle):
        self.handle = handle
        self.digest = hashlib.sha256()

    def read(self, size):
        chunk = self.handle.read(size)
        self.digest.update(chunk)
        return chunk


try:
    with source.open('rb') as handle:
        before = os.fstat(handle.fileno())
        reader = DigestReader(handle)
        with tarfile.open(fileobj=reader, mode='r|gz') as archive:
            for member in archive:
                archive.members.clear()
                member_count += 1
                if member_count > 100_000:
                    raise ValueError('member limit')
                raw = member.name
                name = posixpath.normpath(raw)
                if member.isdir() and member.size != 0:
                    raise ValueError('invalid directory member')
                if member.isdir() and raw in {'.', './'}:
                    continue
                if (
                    raw.startswith('/') or name in {'', '.', '..'} or name.startswith('../')
                    or len(raw.encode('utf-8', errors='surrogateescape')) > 4096
                    or '..' in raw.split('/') or '\\' in raw
                    or any(ord(character) < 32 or ord(character) == 127 for character in raw)
                    or any(len(part.encode('utf-8', errors='surrogateescape')) > 255 for part in raw.split('/'))
                    or name in seen
                    or not (member.isfile() or member.isdir())
                ):
                    raise ValueError('unsafe member')
                seen.add(name)
                top = name.split('/', 1)[0]
                if top in {'data', 'storage.d'}:
                    if name == top and not member.isdir():
                        raise ValueError('invalid root member')
                elif name not in selected | legacy_files or not member.isfile():
                    raise ValueError('unexpected member')
                if not member.isfile():
                    continue
                total_bytes += member.size
                if member.size < 0 or total_bytes > 2 * 1024 ** 4:
                    raise ValueError('expanded size limit')
                if (name == 'manifest' and member.size > 4096) or (name == 'checksums.sha256' and member.size > 256 * 1024 ** 2):
                    raise ValueError('manifest size limit')
                output = None
                if name in selected:
                    if shutil.disk_usage(root).free <= member.size + 16 * 1024 ** 2:
                        raise ValueError('insufficient database staging space')
                    output = (root / name).open('xb')
                digest = hashlib.sha256()
                try:
                    with archive.extractfile(member) as entry:
                        for chunk in iter(lambda: entry.read(1024 * 1024), b''):
                            digest.update(chunk)
                            if output is not None:
                                output.write(chunk)
                finally:
                    if output is not None:
                        output.close()
                if name != 'checksums.sha256':
                    hashes[name] = digest.hexdigest()
        while reader.read(1024 * 1024):
            pass
        after = os.fstat(handle.fileno())
        if (before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (after.st_size, after.st_mtime_ns, after.st_ctime_ns):
            raise ValueError('archive changed during validation')
    checksum = source.with_name(source.name + '.sha256')
    if checksum.exists():
        if checksum.stat().st_size > 4096:
            raise ValueError('oversized checksum file')
        match = re.fullmatch(r'([0-9a-fA-F]{64}) [ *](.+)\n?', checksum.read_text(encoding='utf-8'))
        if not match or match[2] != source.name or not hmac.compare_digest(reader.digest.hexdigest(), match[1].lower()):
            raise ValueError('archive checksum mismatch')
    if not selected <= seen:
        raise ValueError('missing database or manifest')
    manifest = {}
    for line in (root / 'manifest').read_text(encoding='utf-8').splitlines():
        key, separator, value = line.partition('=')
        if not separator or key in manifest:
            raise ValueError('invalid backup manifest')
        manifest[key] = value
    if manifest.get('format') == '2':
        if manifest.get('scope') != 'database' or seen != selected:
            raise ValueError('invalid database-only backup')
    elif manifest.get('format') != '1' or 'data' not in seen:
        raise ValueError('unsupported backup format')
    expected = {}
    for line in (root / 'checksums.sha256').read_text(encoding='utf-8').splitlines():
        match = re.fullmatch(r'([0-9a-f]{64}) [ *](\./.+)', line)
        if not match:
            raise ValueError('invalid checksum line')
        name = posixpath.normpath(match[2])
        if name in expected or name not in hashes:
            raise ValueError('invalid checksum target')
        expected[name] = match[1]
    if expected != hashes:
        raise ValueError('checksum inventory mismatch')
except Exception:
    raise SystemExit(1)
PY
  compose exec -T vueio_postgres pg_restore --list <"$tmp/database.dump" >/dev/null ||
    die "PostgreSQL backup validation failed"
  if grep -qx 'format=1' "$tmp/manifest"; then
    note "Legacy backup: archived application files and configuration will not be restored."
  fi
  previous_version=$(env_value VUEIO_VERSION)
  previous_engine_image=$(env_value VUEIO_ENGINE_IMAGE)
  previous_ui_image=$(env_value VUEIO_UI_IMAGE)
  [[ -z ${VUEIO_RESTORE_REPIN_VERSION:-} ]] || validate_release_tag "$VUEIO_RESTORE_REPIN_VERSION"

  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  safety="$BACKUP_DIR/pre-restore-$stamp.tar.gz"
  if compose ps --status running -q vueio_engine 2>/dev/null | grep -q .; then
    engine_was_running=true
  fi
  VUEIO_BACKUP_LEAVE_ENGINE_STOPPED=1 backup_vueio "$safety"
  engine_stopped=true
  safety_db="$tmp/safety-database.dump"
  tar -xOzf "$safety" ./database.dump >"$safety_db"
  [[ -s $safety_db ]] || die "Safety backup did not contain a database dump"

  # Invoked by the EXIT trap below. All file content remains untouched.
  # shellcheck disable=SC2317,SC2329
  rollback_restore() {
    local status=$? recovered=true
    trap - EXIT INT TERM
    set +e
    warn "Restore did not complete; recovering the previous database and release."
    compose stop vueio_engine >/dev/null 2>&1
    if [[ $db_restored == true ]]; then
      compose exec -T vueio_postgres pg_restore \
        --clean --if-exists --single-transaction --no-owner --no-acl \
        -U "$(env_value VUEIO_POSTGRES_USER)" \
        -d "$(env_value VUEIO_POSTGRES_DB)" <"$safety_db" || recovered=false
    fi
    if [[ $environment_changed == true ]]; then
      set_env VUEIO_VERSION "$previous_version" || recovered=false
      set_env VUEIO_ENGINE_IMAGE "$previous_engine_image" || recovered=false
      set_env VUEIO_UI_IMAGE "$previous_ui_image" || recovered=false
    fi
    if [[ $recovered == true && $engine_was_running == true ]]; then
      compose up -d >/dev/null 2>&1 && wait_for_engine >/dev/null 2>&1 || recovered=false
    fi
    rm -rf "$tmp"
    if [[ $recovered == true ]]; then
      warn "The previous database and release were restored. Safety backup: $safety"
    else
      compose stop vueio_engine >/dev/null 2>&1
      warn "Automatic recovery was incomplete. Vueio was left stopped. Safety backup: $safety"
    fi
    exit "$status"
  }
  trap rollback_restore EXIT

  # Mark the database as possibly changed before pg_restore can commit.
  db_restored=true
  compose exec -T vueio_postgres pg_restore \
    --clean --if-exists --single-transaction --no-owner --no-acl \
    -U "$(env_value VUEIO_POSTGRES_USER)" \
    -d "$(env_value VUEIO_POSTGRES_DB)" <"$tmp/database.dump"
  if [[ -n ${VUEIO_RESTORE_REPIN_VERSION:-} ]]; then
    environment_changed=true
    set_env VUEIO_VERSION "$VUEIO_RESTORE_REPIN_VERSION"
    set_env VUEIO_ENGINE_IMAGE "$(env_value VUEIO_ENGINE_REPOSITORY):$VUEIO_RESTORE_REPIN_VERSION"
    set_env VUEIO_UI_IMAGE "$(env_value VUEIO_UI_REPOSITORY):$VUEIO_RESTORE_REPIN_VERSION"
  fi
  compose up -d
  doctor
  engine_stopped=false
  trap - EXIT INT TERM
  rm -f "$UPDATE_STATE_FILE" "$UPDATE_PROGRESS_FILE"
  rm -rf "$tmp"
  note "Database restore completed. Safety backup: $safety"
  note "Current application files, media, and host configuration were retained."
)

pull_release_images() {
  local version=$1
  if [[ ${VUEIO_SKIP_PULL:-0} == 1 ]]; then
    return 0
  fi
  docker pull "$(env_value VUEIO_ENGINE_REPOSITORY):$version"
  docker pull "$(env_value VUEIO_UI_REPOSITORY):$version"
}

rollback_vueio() {
  require_installed
  local archive='' version created confirmation
  archive=$(
    find "$BACKUP_DIR" -maxdepth 1 -type f -name 'pre-update-*.tar.gz' -printf '%T@\t%p\n' |
      sort -rn |
      head -n 1 |
      cut -f2-
  )
  [[ -n $archive && -f $archive ]] || die "No pre-update safety backup is available"
  version=$(backup_manifest_value "$archive" version)
  created=$(backup_manifest_value "$archive" created_at)
  validate_release_tag "$version"

  note "This returns Vueio to version $version and the database as it was at $created."
  warn "Database changes since that backup will be lost. All current application files and media stay in place."
  if [[ ${VUEIO_NONINTERACTIVE:-0} != 1 ]]; then
    printf 'Type RESTORE to continue: '
    read -r confirmation
    [[ $confirmation == RESTORE ]] || {
      note "Rollback cancelled. Nothing was changed."
      return 0
    }
  elif [[ ${VUEIO_RESTORE_CONFIRM:-} != RESTORE ]]; then
    die "Set VUEIO_RESTORE_CONFIRM=RESTORE for a non-interactive rollback"
  fi

  step "Downloading the previous version before stopping Vueio"
  pull_release_images "$version"
  VUEIO_NONINTERACTIVE=1 \
    VUEIO_RESTORE_CONFIRM=RESTORE \
    VUEIO_RESTORE_REPIN_VERSION="$version" \
    restore_vueio "$archive"
  success "Vueio was returned to $version."
}

state_value() {
  local key=$1
  [[ -f $UPDATE_STATE_FILE ]] || return 0
  sed -n "s/^${key}=//p" "$UPDATE_STATE_FILE" | tail -n 1
}

write_update_progress() {
  local state=$1 phase=$2 progress=$3 message=$4
  python3 - "$UPDATE_PROGRESS_FILE" "$state" "$phase" "$progress" "$message" \
    "${UPDATE_REQUESTED_VERSION:-}" "${UPDATE_PREVIOUS_VERSION:-}" "${VUEIO_UPDATE_OPERATION_ID:-}" \
    "${VUEIO_HOST_OPERATION:-update}" "${VUEIO_TARGET_CHANNEL:-}" <<'PY'
import json
import os
import sys
import tempfile

path, state, phase, progress, message, version, previous, operation_id, operation, target_channel = sys.argv[1:]
descriptor, temporary = tempfile.mkstemp(prefix='.update-progress.', dir=os.path.dirname(path))
try:
    with os.fdopen(descriptor, 'w', encoding='utf-8') as handle:
        json.dump(dict(supported=True, state=state, phase=phase, progress=int(progress),
                       message=message, version=version or None, previous_version=previous or None,
                       operation_id=operation_id or None, operation=operation,
                       target_channel=target_channel or None), handle)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, path)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY
}

write_update_state() {
  local phase=$1 previous=$2 requested=$3 backup=${4:-} tmp
  tmp=$(mktemp "$VUEIO_HOME/.update-state.XXXXXX")
  {
    printf 'phase=%s\n' "$phase"
    printf 'previous_version=%s\n' "$previous"
    printf 'requested_version=%s\n' "$requested"
    printf 'backup=%s\n' "$backup"
    printf 'log=%s\n' "${UPDATE_LOG_FILE:-}"
  } >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$UPDATE_STATE_FILE"
}

update_stage() {
  local number=$1 name=$2 message=$3 progress
  note "Step $number/7 — $message"
  write_update_state "$name" "$UPDATE_PREVIOUS_VERSION" "$UPDATE_REQUESTED_VERSION" "${UPDATE_BACKUP:-}"
  case "$name" in
    preflight) progress=5 ;;
    assets) progress=15 ;;
    images) progress=25 ;;
    backup) progress=50 ;;
    install) progress=70 ;;
    restart) progress=80 ;;
    health) progress=95 ;;
    *) die "Unknown update phase" ;;
  esac
  write_update_progress running "$name" "$progress" "$message"
  if [[ ${VUEIO_UPDATE_FAIL_AT:-} == "$name" ]]; then
    die "Update interruption rehearsal at stage: $name"
  fi
}

verify_release_for_channel() {
  local version=$1 purpose=${2:-update} channel repository response token_header=()
  channel=$(env_value VUEIO_CHANNEL)
  channel=${channel:-stable}
  validate_channel "$channel"
  if [[ $purpose != installed && $channel == stable ]] && is_nightly_tag "$version"; then
    die "The stable channel cannot install nightly builds. Run '$PROGRAM channel nightly' first."
  fi
  if [[ ${VUEIO_SKIP_RELEASE_VALIDATION:-0} == 1 || (
    ${VUEIO_SKIP_ASSET_REFRESH:-0} == 1 && ${VUEIO_SKIP_PULL:-0} == 1
  ) ]]; then
    return 0
  fi
  repository=$(env_value VUEIO_UPDATE_REPOSITORY)
  [[ $repository =~ ^[A-Za-z0-9][A-Za-z0-9.-]*/[A-Za-z0-9][A-Za-z0-9._-]*$ &&
    $repository != "$(printf '%s%s' 'your-' 'owner')"/* ]] ||
    die "The public release repository is not configured"
  response=$(mktemp "$VUEIO_HOME/.release-check.XXXXXX")
  if [[ -n ${VUEIO_UPDATE_GITHUB_TOKEN:-} ]]; then
    token_header=(-H "Authorization: Bearer $VUEIO_UPDATE_GITHUB_TOKEN")
  fi
  curl -fsSL --connect-timeout 10 --max-time 30 \
    -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2022-11-28' \
    "${token_header[@]}" \
    "https://api.github.com/repos/$repository/releases/tags/$version" \
    -o "$response" || {
      rm -f "$response"
      die "Release $version was not found in the configured repository"
    }
  python3 - "$response" "$version" <<'PY' || {
import json
import sys

path, requested = sys.argv[1:]
release = json.load(open(path, encoding='utf-8'))
nightly = '.dev.' in requested
valid = (
    release.get('tag_name') == requested
    and not release.get('draft')
    and bool(release.get('prerelease')) == nightly
)
raise SystemExit(0 if valid else 1)
PY
    rm -f "$response"
    die "Release $version is not published in the expected channel"
  }
  rm -f "$response"
}

update_preflight() {
  local version=$1 database_bytes available_kb required_kb probe
  require_command curl
  require_command docker
  require_command python3
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required"
  docker info >/dev/null 2>&1 || die "Docker is installed but is not running"
  mkdir -p "$BACKUP_DIR" "$LOG_DIR"
  probe=$(mktemp "$BACKUP_DIR/.write-test.XXXXXX") || die "The backup directory is not writable"
  rm -f "$probe"
  database_bytes=$(database_size_bytes)
  available_kb=$(df -Pk "$VUEIO_HOME" | awk 'NR == 2 {print $4}')
  required_kb=$(((2 * database_bytes + 1023) / 1024 + 2 * 1024 * 1024))
  ((available_kb > required_kb)) ||
    die "The update needs about $((required_kb / 1024)) MiB free for its backup and container images"
  verify_release_for_channel "$version"
  doctor
}

recover_incomplete_update() {
  [[ -f $UPDATE_STATE_FILE ]] || return 0
  case $(state_value phase) in
    preflight|assets|images|backup)
      warn "The previous update stopped before installing a release. Resuming the existing engine."
      compose start vueio_engine
      doctor
      rm -f "$UPDATE_STATE_FILE"
      ;;
    *) die "An interrupted update needs review on the host. Review its log and backup before '$PROGRAM rollback'. No data was restored automatically." ;;
  esac
}

update_failure_handler() {
  local status=$1 phase=${2:-an unknown stage}
  trap - EXIT INT TERM
  set +e
  [[ $status != 0 ]] || return 0
  warn "The update failed during $phase."
  case "$phase" in
    preflight|assets|images|backup)
      if [[ $phase != backup ]] || compose start vueio_engine >/dev/null 2>&1; then
        rm -f "$UPDATE_STATE_FILE"
        write_update_progress failed failed 0 "The update stopped before installation. The installed release was kept."
      else
        write_update_progress interrupted failed 50 "The backup did not finish and Vueio needs attention on the host."
      fi
      ;;
    *)
      # The candidate may already have accepted writes. An automatic database
      # restore here could destroy those writes, even after a successful boot.
      compose stop vueio_engine >/dev/null 2>&1 || true
      write_update_progress interrupted failed 0 "The update needs attention on the host. Review the update log and recovery backup."
      warn "Vueio was stopped to protect its data. No backup was restored automatically."
      ;;
  esac
  [[ -z ${UPDATE_STAGE_DIRECTORY:-} ]] || rm -rf -- "$UPDATE_STAGE_DIRECTORY"
  [[ -z ${UPDATE_LOG_FILE:-} ]] || warn "Update log: $UPDATE_LOG_FILE"
  exit "$status"
}

update_vueio() (
  set -Eeuo pipefail
  require_installed
  local version=${1:-} release_root asset_base stage controller_target controller_tmp current_version stamp
  [[ -n $version ]] || die "Usage: $PROGRAM update <release-tag>"
  validate_release_tag "$version"
  VUEIO_UPDATE_IN_PROGRESS=1
  export VUEIO_UPDATE_IN_PROGRESS
  recover_incomplete_update
  current_version=$(env_value VUEIO_VERSION)
  validate_release_tag "$current_version"
  if [[ $version == "$current_version" ]]; then
    doctor
    write_update_progress succeeded complete 100 "This release is already installed."
    note "Vueio $version is already installed. Nothing was changed."
    return 0
  fi
  if ! version_is_newer "$version" "$current_version"; then
    die "$version is older than the installed $current_version. Updates never run migrations backward; use '$PROGRAM rollback' to restore a pre-update backup."
  fi

  UPDATE_PREVIOUS_VERSION=$current_version
  UPDATE_REQUESTED_VERSION=$version
  UPDATE_BACKUP=
  export UPDATE_PREVIOUS_VERSION UPDATE_REQUESTED_VERSION UPDATE_BACKUP
  trap 'status=$?; update_failure_handler "$status" "$(state_value phase)"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  note "Updating Vueio from $current_version to $version."

  update_stage 1 preflight "Checking the current installation and available space…"
  update_preflight "$version"
  prepare_updater_directory

  update_stage 2 assets "Verifying the update files…"
  release_root=$(env_value VUEIO_RELEASE_ROOT_URL)
  release_root=${release_root:-https://github.com/rfxmedia/vueio/releases}
  asset_base="$release_root/download/$version"
  stage=$(mktemp -d "$VUEIO_HOME/.update.XXXXXX")
  UPDATE_STAGE_DIRECTORY=$stage
  if [[ ${VUEIO_SKIP_ASSET_REFRESH:-0} != 1 ]]; then
    curl -fsSL --connect-timeout 10 --max-time 180 "$asset_base/SHA256SUMS" -o "$stage/SHA256SUMS"
    curl -fsSL --connect-timeout 10 --max-time 180 "$asset_base/compose.release.yml" -o "$stage/compose.release.yml"
    curl -fsSL --connect-timeout 10 --max-time 180 "$asset_base/vueioctl" -o "$stage/vueioctl"
    curl -fsSL --connect-timeout 10 --max-time 180 "$asset_base/vueio-updater.py" -o "$stage/vueio-updater.py"
    # Old releases have no native helper; CPU remains available on those versions.
    if grep -Eq '[[:space:]]vueio-media\.py$' "$stage/SHA256SUMS"; then
      curl -fsSL --connect-timeout 10 --max-time 180 "$asset_base/vueio-media.py" -o "$stage/vueio-media.py"
    fi
    curl -fsSL --connect-timeout 10 --max-time 180 "$asset_base/LICENSE.md" -o "$stage/LICENSE.md"
    grep -Eq '[[:space:]]vueioctl$' "$stage/SHA256SUMS" || die "Release checksums do not include vueioctl"
    grep -Eq '[[:space:]]vueio-updater\.py$' "$stage/SHA256SUMS" || die "Release checksums do not include vueio-updater.py"
    grep -Eq '[[:space:]]compose\.release\.yml$' "$stage/SHA256SUMS" || die "Release checksums do not include compose.release.yml"
    grep -Eq '[[:space:]]LICENSE\.md$' "$stage/SHA256SUMS" || die "Release checksums do not include LICENSE.md"
    (cd "$stage" && sha256sum --ignore-missing -c SHA256SUMS)
    bash -n "$stage/vueioctl"
    python3 -c 'import ast, pathlib, sys; ast.parse(pathlib.Path(sys.argv[1]).read_text())' "$stage/vueio-updater.py"
    if [[ -f $stage/vueio-media.py ]]; then
      python3 -c 'import ast, pathlib, sys; ast.parse(pathlib.Path(sys.argv[1]).read_text())' "$stage/vueio-media.py"
    fi
    local installation=()
    [[ ! -f "$DATA_COMPOSE_FILE" ]] || installation+=(-f "$DATA_COMPOSE_FILE")
    [[ ! -f "$INSTALLATION_COMPOSE_FILE" ]] || installation+=(-f "$INSTALLATION_COMPOSE_FILE")
    docker compose --env-file "$ENV_FILE" -f "$stage/compose.release.yml" -f "$STORAGE_COMPOSE_FILE" "${installation[@]}" config -q
  fi

  update_stage 3 images "Downloading the update…"
  pull_release_images "$version"

  update_stage 4 backup "Pausing Vueio and backing up your database…"
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  local backup_destination="$BACKUP_DIR/pre-update-$stamp.tar.gz"
  VUEIO_BACKUP_KIND=pre-update VUEIO_BACKUP_TARGET_VERSION="$version" \
    VUEIO_BACKUP_LEAVE_ENGINE_STOPPED=1 backup_vueio "$backup_destination"
  # Only record a backup after its archive and checksum have both completed.
  UPDATE_BACKUP=$backup_destination
  export UPDATE_BACKUP
  write_update_state backup "$current_version" "$version" "$UPDATE_BACKUP"

  update_stage 5 install "Installing the verified update…"
  if [[ ${VUEIO_SKIP_ASSET_REFRESH:-0} != 1 ]]; then
    install -m 0644 "$stage/compose.release.yml" "$COMPOSE_FILE"
    install -m 0644 "$stage/LICENSE.md" "$LICENSE_FILE"
    controller_target=$(readlink -f "$0")
    controller_tmp=$(mktemp "$(dirname "$controller_target")/.vueioctl.XXXXXX")
    install -m 0755 "$stage/vueioctl" "$controller_tmp"
    mv -f "$controller_tmp" "$controller_target"
    if [[ -f $stage/vueio-media.py ]]; then
      install -m 0644 "$stage/vueio-media.py" "$VUEIO_HOME/vueio-media.py.next"
      mv -f "$VUEIO_HOME/vueio-media.py.next" "$VUEIO_HOME/vueio-media.py"
    fi
    install -m 0644 "$stage/vueio-updater.py" "$UPDATER_FILE.next"
    mv -f "$UPDATER_FILE.next" "$UPDATER_FILE"
  fi
  set_env VUEIO_VERSION "$version"
  set_env VUEIO_ENGINE_IMAGE "$(env_value VUEIO_ENGINE_REPOSITORY):$version"
  set_env VUEIO_UI_IMAGE "$(env_value VUEIO_UI_REPOSITORY):$version"

  update_stage 6 restart "Restarting Vueio and updating its database…"
  compose up -d
  wait_for_engine || die "The updated engine did not become ready"

  update_stage 7 health "Checking that Vueio is ready…"
  doctor
  # Health is the commit point. A cleanup or status-write error must never stop
  # the healthy release or restore a backup after it can accept new writes.
  trap - EXIT INT TERM
  rm -rf "$stage" || warn "The update staging directory needs cleanup on the host."
  rm -f "$UPDATE_STATE_FILE"
  write_update_progress succeeded complete 100 "Vueio was updated successfully."
  success "Vueio is running release $version."
)

cleanup_update_logs() {
  local log
  local -a logs=()
  mapfile -t logs < <(find "$LOG_DIR" -maxdepth 1 -type f -name 'update-*.log' -printf '%T@\t%p\n' | sort -rn | cut -f2-)
  for log in "${logs[@]:10}"; do
    rm -f -- "$log"
  done
}

run_logged_update() {
  require_installed
  local stamp status
  (($# <= 1)) || die "Usage: $PROGRAM update [release-tag]"
  if (($# == 0)); then
    local latest
    step "Checking for updates on your channel"
    latest=$(compose exec -T vueio_engine python - <<'PY'
from app.services.release_updates import get_update_status
status = get_update_status(force_refresh=True)
if status['status'] in {'error', 'unavailable', 'checking'}:
    raise SystemExit('The release could not be checked. Try again when Vueio and the internet connection are available.')
print(status['latest_version'] if status['update_available'] else '')
PY
    ) || die "Could not check the latest release. Start Vueio first, or use the exact update command from Settings."
    if [[ -z $latest ]]; then success "No newer release is available on your channel."; return 0; fi
    set -- "$latest"
  fi
  validate_release_tag "$1"
  require_command python3
  UPDATE_REQUESTED_VERSION=$1
  UPDATE_PREVIOUS_VERSION=$(env_value VUEIO_VERSION)
  VUEIO_UPDATE_OPERATION_ID=${VUEIO_UPDATE_OPERATION_ID:-$(python3 -c 'import uuid; print(uuid.uuid4().hex)')}
  export UPDATE_REQUESTED_VERSION UPDATE_PREVIOUS_VERSION VUEIO_UPDATE_OPERATION_ID
  mkdir -p "$LOG_DIR"
  chmod 700 "$LOG_DIR"
  stamp=$(date -u +%Y%m%dT%H%M%S%NZ)
  UPDATE_LOG_FILE="$LOG_DIR/update-$stamp.log"
  export UPDATE_LOG_FILE
  touch "$UPDATE_LOG_FILE"
  chmod 600 "$UPDATE_LOG_FILE"
  cleanup_update_logs
  write_update_progress running queued 0 "Preparing the update…"
  set +e
  update_vueio "$@" > >(tee -a "$UPDATE_LOG_FILE") 2> >(tee -a "$UPDATE_LOG_FILE" >&2)
  status=$?
  set -e
  if ((status != 0)); then
    if python3 - "$UPDATE_PROGRESS_FILE" <<'PY'
import json
import sys
raise SystemExit(0 if json.load(open(sys.argv[1], encoding='utf-8')).get('state') == 'running' else 1)
PY
    then
      write_update_progress failed failed 0 "The update could not start. Review the host update log."
    fi
    warn "Update failed. Review $UPDATE_LOG_FILE, then run: sudo $PROGRAM doctor"
  fi
  return "$status"
}

terminal_menu() {
  [[ -t 0 && -t 1 ]] || { usage; return; }
  require_installed
  local choice answer destination
  while true; do
    screen "WORKSPACE" "What would you like to do?"
    note "  $(env_value VUEIO_VERSION) · $(env_value VUEIO_CHANNEL)"
    note "  $(env_value VUEIO_CORS_ALLOW_ORIGINS)"
    title "  Manage"
    printf '  [1] Status          [2] Update\n'
    title "  Run"
    printf '  [3] Start           [4] Restart       [5] Stop\n'
    title "  Data and releases"
    printf '  [6] Back up database\n  [7] Data and backup folders\n  [8] Stable / Nightly\n\n'
    note "  ?  All commands   ·   q  Exit menu"
    printf '\n  %sChoose an option ›%s ' "$MINT" "$RESET"
    IFS= read -r choice || break
    case "$choice" in
      1|/status) "$0" status || true ;;
      2|/update)
        if confirm "Check for an update and install it? Vueio pauses briefly; a database backup is created first."; then "$0" update || true; fi ;;
      3|/start) "$0" start || true ;;
      4|/restart)
        if confirm "Restart Vueio? Finish active uploads first."; then "$0" restart || true; fi ;;
      5|/stop)
        if confirm "Stop Vueio? Review links will be offline until you start it again."; then "$0" stop || true; fi ;;
      6|/backup)
        note "Creates a database backup. Media and app files are not included."
        note "Press Enter for the default, or enter a full archive path on another drive."
        printf 'Backup file: '
        IFS= read -r destination || break
        if [[ -n $destination ]]; then "$0" backup "$destination" || true; else "$0" backup || true; fi ;;
      7|/data) "$0" data || true ;;
      8|/channel)
        note "Stable: reviewed releases. Nightly: earlier updates."
        note "Changing channels never downgrades your database or installed version."
        printf 'Channel [stable/nightly, Enter to cancel]: '
        IFS= read -r answer || break
        case "$answer" in
          stable|nightly) "$0" channel "$answer" || true ;;
          '') ;;
          *) warn "Enter stable or nightly. Nothing was changed." ;;
        esac ;;
      /help|help|\?) usage ;;
      /exit|exit|quit|q) break ;;
      '') continue ;;
      *) warn "That is not a Vueio command. Use /help. No shell command was run." ;;
    esac
    printf '\nPress Enter to return to the menu. '
    IFS= read -r answer || break
  done
}

updater() {
  require_installed
  local action=${1:-status} controller unit_name stage version release_root python_path ready=false
  (($# <= 1)) || die "Usage: $PROGRAM updater <enable|disable|status|serve>"
  controller=$(readlink -f "$0")
  case "$action" in
    status)
      if [[ $(uname -s) == Darwin ]]; then
        python3 - "$VUEIO_HOME/updater/access-token" "$(env_value VUEIO_UPDATER_PORT)" <<'PY'
import json, pathlib, sys, urllib.request
token = pathlib.Path(sys.argv[1]).read_text().strip()
request = urllib.request.Request(f'http://127.0.0.1:{int(sys.argv[2])}/status', headers={'Authorization': f'Bearer {token}'})
with urllib.request.urlopen(request, timeout=3) as response:
    print(json.dumps(json.load(response), indent=2))
PY
        return
      fi
      require_command curl
      curl --fail --silent --show-error --max-time 3 \
        --unix-socket "$VUEIO_HOME/updater/control.sock" http://localhost/status
      printf '\n'
      return
      ;;
    serve)
      [[ -f "$UPDATER_FILE" ]] || die "The updater is not installed. Run '$PROGRAM updater enable' first."
      exec python3 "$UPDATER_FILE" --home "$VUEIO_HOME" --controller "$controller"
      ;;
    enable|disable) ;;
    *) die "Usage: $PROGRAM updater <enable|disable|status|serve>" ;;
  esac
  if [[ $(uname -s) == Darwin ]]; then
    local agent_label agent_file
    agent_label="io.vueio.host.$(printf '%s' "$VUEIO_HOME" | sha256sum | cut -c1-12)"
    agent_file="$HOME/Library/LaunchAgents/$agent_label.plist"
    if [[ $action == disable ]]; then
      launchctl bootout "gui/$(id -u)/$agent_label" 2>/dev/null || true
      rm -f -- "$agent_file"
      note "The Mac host helper was disabled. Terminal commands remain available."
      return
    fi
    [[ -f $UPDATER_FILE ]] || die "The host helper is missing. Reinstall its verified release asset first."
    prepare_updater_directory
    mkdir -p "$HOME/Library/LaunchAgents"
    python3 - "$agent_file" "$agent_label" "$(command -v python3)" "$UPDATER_FILE" "$VUEIO_HOME" "$controller" <<'PY'
import os, pathlib, plistlib, sys
destination, label, python, helper, home, controller = sys.argv[1:]
document = dict(Label=label, ProgramArguments=[python, helper, '--home', home, '--controller', controller],
                RunAtLoad=True, KeepAlive=True, ThrottleInterval=10, Umask=0o077,
                EnvironmentVariables={key: os.environ[key] for key in ('HOME', 'PATH') if key in os.environ})
path = pathlib.Path(destination)
if path.is_symlink():
    raise SystemExit('The launch agent path must not be a symbolic link.')
with path.open('wb') as handle:
    plistlib.dump(document, handle)
path.chmod(0o600)
PY
    launchctl bootout "gui/$(id -u)/$agent_label" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$agent_file"
    compose up -d --no-deps vueio_engine
    wait_for_engine || die "Vueio did not restart after enabling its Mac helper."
    for _ in {1..20}; do
      if compose exec -T vueio_engine python -c 'from app.services.host_updates import get_host_update_status; raise SystemExit(0 if get_host_update_status()["supported"] else 1)' >/dev/null 2>&1; then
        success "Updates and drive management are connected to this Mac."
        return
      fi
      sleep 1
    done
    die "Vueio cannot reach its Mac helper. It remains local-only; no network port was opened. Check Docker Desktop and run '$PROGRAM updater enable' again."
  fi
  [[ $(id -u) == 0 ]] || die "Run this command with sudo"
  unit_name="vueio-updater-$(printf '%s' "$VUEIO_HOME" | sha256sum | cut -c1-12).service"
  if [[ $action == disable ]]; then
    require_command systemctl
    [[ -d /run/systemd/system ]] || die "Stop the foreground updater with your host's service manager"
    systemctl disable --now "$unit_name"
    rm -f "/etc/systemd/system/$unit_name" "$VUEIO_HOME/updater/control.sock"
    systemctl daemon-reload
    note "One-click updates were disabled. The host update command remains available."
    return
  fi
  [[ ! -f "$UPDATE_STATE_FILE" ]] || die "Review the interrupted update on the host before enabling its updater"
  require_command python3
  require_command curl
  python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' || die "The host updater needs Python 3.9 or newer"
  python_path=$(command -v python3)
  prepare_updater_directory
  if [[ ! -f "$UPDATER_FILE" ]]; then
    # Older controllers did not download the helper. Bootstrap only from the
    # installed published release, with its required checksum entry.
    version=$(env_value VUEIO_VERSION)
    validate_release_tag "$version"
    verify_release_for_channel "$version" installed
    release_root=$(env_value VUEIO_RELEASE_ROOT_URL)
    [[ $release_root == https://* ]] || die "Configure an HTTPS release asset URL before enabling updates"
    stage=$(mktemp -d "$VUEIO_HOME/.updater-download.XXXXXX")
    if ! curl -fsSL --connect-timeout 10 --max-time 180 "$release_root/download/$version/SHA256SUMS" -o "$stage/SHA256SUMS" ||
      ! curl -fsSL --connect-timeout 10 --max-time 180 "$release_root/download/$version/vueio-updater.py" -o "$stage/vueio-updater.py" ||
      ! grep -Eq '[[:space:]]vueio-updater\.py$' "$stage/SHA256SUMS" ||
      ! (cd "$stage" && sha256sum --ignore-missing --quiet -c SHA256SUMS) ||
      ! python3 -c 'import ast, pathlib, sys; ast.parse(pathlib.Path(sys.argv[1]).read_text())' "$stage/vueio-updater.py"; then
      rm -rf "$stage"
      die "The installed release's updater helper could not be verified"
    fi
    install -m 0644 "$stage/vueio-updater.py" "$UPDATER_FILE"
    rm -rf "$stage"
  fi
  if ! command -v systemctl >/dev/null 2>&1 || [[ ! -d /run/systemd/system ]]; then
    note "The verified host updater is prepared. Configure your host's service manager to run '$PROGRAM updater serve' as root."
    return
  fi
  # Keep generated service directives literal and unambiguous.
  [[ $VUEIO_HOME =~ ^/[A-Za-z0-9_./-]+$ && $controller =~ ^/[A-Za-z0-9_./-]+$ && $python_path =~ ^/[A-Za-z0-9_./-]+$ ]] ||
    die "Managed updater service paths must use letters, numbers, slashes, dots, underscores, and dashes"
  cat >"/etc/systemd/system/$unit_name" <<EOF
[Unit]
Description=Vueio host updater
RequiresMountsFor=$VUEIO_HOME
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=$python_path $UPDATER_FILE --home $VUEIO_HOME --controller $controller
Restart=on-failure
RestartSec=3
KillMode=process
UMask=0077

[Install]
WantedBy=multi-user.target
EOF
  chmod 644 "/etc/systemd/system/$unit_name"
  systemctl daemon-reload
  systemctl enable "$unit_name"
  systemctl restart "$unit_name"
  systemctl is-active --quiet "$unit_name" || die "The updater service could not start; inspect its host service log"
  # Apply the socket directory mount to an existing managed installation.
  compose up -d --no-deps vueio_engine
  wait_for_engine || die "Vueio did not become ready after enabling its updater"
  for _ in {1..30}; do
    if curl --fail --silent --max-time 1 --unix-socket "$VUEIO_HOME/updater/control.sock" http://localhost/status >/dev/null; then
      ready=true
      break
    fi
    sleep 0.1
  done
  [[ $ready == true ]] || die "The host updater did not become ready; inspect its service log"
  success "Updates and drive management are enabled in Settings."
}

exposure_set() {
  local url=${1:-} proxy=${2:-} backslash
  printf -v backslash '\x5c'
  [[ $url =~ ^https://[^/[:space:]]+/?$ ]] ||
    die "Use an HTTPS origin such as https://vue.example.com (no path)"
  [[ $url != *'@'* && $url != *'?'* && $url != *'#'* && $url != *"$backslash"* ]] ||
    die "Use an HTTPS origin without credentials, a path, a query, or a fragment"
  [[ -z $proxy || $proxy == --cloudflare ]] ||
    die "The only supported exposure option is --cloudflare"
  url=${url%/}
  set_env VUEIO_PUBLIC_BASE_URL "$url"
  set_env VUEIO_CORS_ALLOW_ORIGINS "$url"
  set_env VUEIO_SESSION_COOKIE_SECURE true
  set_env VUEIO_LOCAL_HTTP false
  set_env VUEIO_TRUST_CLOUDFLARE "$([[ $proxy == --cloudflare ]] && printf true || printf false)"
  set_env VUEIO_TRUST_UPSTREAM_PROXY "$([[ $proxy == --cloudflare ]] && printf false || printf true)"
  set_env VUEIO_BIND_ADDRESS 127.0.0.1
  note "If your proxy is not ready, recover with: $PROGRAM exposure local"
  compose up -d
  doctor
  note "Secure public origin configured: $url"
  [[ $proxy == --cloudflare ]] && note "Cloudflare client-address forwarding is trusted."
  note "Vueio does not create the tunnel or reverse proxy; point yours at the local Vueio port."
}

exposure_local() {
  (($# == 0)) || die "Usage: $PROGRAM exposure local"
  local url
  url="http://127.0.0.1:$(env_value VUEIO_UI_PORT)"
  set_env VUEIO_PUBLIC_BASE_URL ""
  set_env VUEIO_CORS_ALLOW_ORIGINS "$url"
  set_env VUEIO_SESSION_COOKIE_SECURE false
  set_env VUEIO_LOCAL_HTTP true
  set_env VUEIO_TRUST_CLOUDFLARE false
  set_env VUEIO_TRUST_UPSTREAM_PROXY false
  set_env VUEIO_BIND_ADDRESS 127.0.0.1
  compose up -d
  warn "Local HTTP mode enabled on loopback only. Do not expose this port directly to the internet."
}

main() {
  local command=${1:-}
  shift || true
  case "$command" in
    start|restart|backup|restore|rollback|update|channel|exposure) require_installed; require_data_mount ;;
    storage) [[ ${1:-} == list ]] || { require_installed; require_data_mount; } ;;
  esac
  case "$command" in
    start|stop|restart|backup|restore|rollback|update|channel|exposure) maintenance_lock ;;
    storage) [[ ${1:-} == list ]] || maintenance_lock ;;
    doctor) [[ ${1:-} != --fix ]] || maintenance_lock ;;
    updater) [[ ${1:-} != enable && ${1:-} != disable ]] || maintenance_lock ;;
  esac
  case "$command" in
    install) install_vueio "$@" ;;
    start) require_installed; require_storage_mounts; compose up -d ;;
    stop) require_installed; compose stop ;;
    restart) require_installed; require_storage_mounts; compose up -d --force-recreate vueio_engine vueio_ui ;;
    status) require_installed; compose ps ;;
    version) show_version ;;
    data) show_data_location ;;
    menu) terminal_menu ;;
    setup-token) show_setup_token ;;
    setup-info) show_setup_info ;;
    logs)
      require_installed
      if (($#)); then
        compose logs -f "$@"
      else
        compose logs -f
      fi
      ;;
    doctor) doctor "$@" ;;
    backup) backup_vueio "$@" ;;
    backups) list_backups ;;
    restore) restore_vueio "$@" ;;
    rollback) rollback_vueio ;;
    update) run_logged_update "$@" ;;
    channel) set_channel "$@" ;;
    updater) updater "$@" ;;
    storage)
      require_installed
      local action=${1:-}
      shift || true
      case "$action" in
        list) storage_list ;;
        add) storage_add "$@" ;;
        reconnect) storage_reconnect "$@" ;;
        remove) storage_remove "$@" ;;
        *) die "Usage: $PROGRAM storage <list|add|reconnect|remove>" ;;
      esac
      ;;
    exposure)
      require_installed
      local action=${1:-}
      shift || true
      case "$action" in
        set) exposure_set "$@" ;;
        local) exposure_local "$@" ;;
        *) die "Usage: $PROGRAM exposure <set|local>" ;;
      esac
      ;;
    '') terminal_menu ;;
    -h|--help|help|/help) usage ;;
    *) die "Unknown command: $command" ;;
  esac
}

main "$@"
