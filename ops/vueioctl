#!/usr/bin/env bash
# macOS ships Bash 3.2. Use the installed host tools, not a different app build.
if [[ $(command -p uname -s) == Darwin ]]; then
  if [[ $(id -u) == 0 ]]; then
    [[ -n ${SUDO_USER:-} && $SUDO_USER != root ]] || { printf 'Run Vueio as your Mac login account, not root.\n' >&2; exit 1; }
    if [[ -n ${VUEIO_HOME:-} ]]; then
      exec /usr/bin/sudo -H -u "$SUDO_USER" /usr/bin/env "VUEIO_HOME=$VUEIO_HOME" "$0" "$@"
    fi
    exec /usr/bin/sudo -H -u "$SUDO_USER" "$0" "$@"
  fi
  export PATH="/Applications/Docker.app/Contents/Resources/bin:$PATH"
  for vueio_tools in /opt/homebrew /usr/local; do
    if [[ -x $vueio_tools/bin/brew ]]; then
      export PATH="$vueio_tools/opt/coreutils/libexec/gnubin:$vueio_tools/opt/findutils/libexec/gnubin:$vueio_tools/bin:$PATH"
      if ((BASH_VERSINFO[0] < 4)); then exec "$vueio_tools/bin/bash" "$0" "$@"; fi
      break
    fi
  done
fi
set -Eeuo pipefail

PROGRAM=${0##*/}
SCRIPT_DIR=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if [[ $(uname -s) == Darwin ]]; then
  VUEIO_HOME=${VUEIO_HOME:-"$HOME/Library/Application Support/Vueio"}
else
  VUEIO_HOME=${VUEIO_HOME:-/opt/vueio}
fi
export VUEIO_HOME
ORIGINAL_ARGUMENTS=("$@")
COMPOSE_FILE="$VUEIO_HOME/compose.yml"
STORAGE_COMPOSE_FILE="$VUEIO_HOME/compose.storage.yml"
INSTALLATION_COMPOSE_FILE="$VUEIO_HOME/compose.installation.yml"
DATA_COMPOSE_FILE="$VUEIO_HOME/compose.data.yml"
GPU_COMPOSE_FILE="$VUEIO_HOME/compose.gpu.yml"
ENV_FILE="$VUEIO_HOME/.env"
STORAGE_DIR="$VUEIO_HOME/storage.d"
BACKUP_DIR="$VUEIO_HOME/backups"
LOG_DIR="$VUEIO_HOME/logs"
UPDATE_STATE_FILE="$VUEIO_HOME/.update-state"
UPDATE_PROGRESS_FILE="$VUEIO_HOME/.update-progress.json"
UPDATER_FILE="$VUEIO_HOME/vueio-updater.py"
LICENSE_FILE="$VUEIO_HOME/LICENSE.md"
RELEASE_TAG_PATTERN='^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)-alpha\.(0|[1-9][0-9]*)(\.dev\.(0|[1-9][0-9]*))?$'

if [[ -t 1 && ${TERM:-dumb} != dumb && ${VUEIO_PLAIN:-0} != 1 && -z ${NO_COLOR:-} ]]; then
  RESET=$'\033[0m'
  BOLD=$'\033[1m'
  GREEN=$'\033[32m'
  MINT=$'\033[38;5;121m'
  YELLOW=$'\033[33m'
  MUTED=$'\033[2m'
else
  RESET=
  BOLD=
  GREEN=
  MINT=
  YELLOW=
  MUTED=
fi

die() {
  printf '%sError:%s %s\n' "$BOLD" "$RESET" "$*" >&2
  exit 1
}

note() {
  printf '%s\n' "$*"
}

warn() {
  printf '%s!%s %s\n' "$YELLOW" "$RESET" "$*" >&2
}

title() {
  printf '\n%s%s%s%s\n' "$BOLD" "$MINT" "$*" "$RESET"
}

step() {
  printf '%s→%s %s\n' "$MINT" "$RESET" "$*"
}

success() {
  printf '%s✓%s %s\n' "$GREEN" "$RESET" "$*"
}

# One decision per screen. Plain output keeps the complete transcript.
screen() {
  if [[ ${3:-} != keep && -t 0 && -t 1 && ${TERM:-dumb} != dumb && ${VUEIO_PLAIN:-0} != 1 ]]; then
    printf '\033[H\033[2J'
  fi
  printf '\n  %s%svueio%s   %s%s%s\n' "$BOLD" "$MINT" "$RESET" "$MUTED" "$1" "$RESET"
  local width=${COLUMNS:-80}
  [[ $width =~ ^[0-9]{1,3}$ ]] || width=80
  width=$((10#$width))
  ((width > 76)) && width=76
  ((width < 20)) && width=20
  printf '  %s' "$MUTED"
  printf '%*s' "$((width - 4))" '' | tr ' ' '-'
  printf '%s\n' "$RESET"
  title "  $2"
  printf '\n'
}

option() {
  if [[ -n $1 ]]; then
    printf '  %s[%s]%s  %s\n' "$MINT" "$1" "$RESET" "$2"
  else
    printf '  %s%s%s\n' "$BOLD" "$2" "$RESET"
  fi
  [[ -z ${3:-} ]] || printf '       %s%s%s\n' "$MUTED" "$3" "$RESET"
  printf '\n'
}

choose_hint() {
  printf '  Enter  Use default   ·   ?  Details   ·   q  Cancel\n'
  printf '  Or enter a drive number or a full folder path.\n'
}

confirm() {
  local answer
  printf '%s [Y/n] ' "$1"
  read -r answer || return 1
  [[ -z $answer || $answer == y || $answer == Y || $answer == yes || $answer == YES ]]
}

[[ $VUEIO_HOME = /* && $VUEIO_HOME != / ]] ||
  die "VUEIO_HOME must be an absolute directory other than /"

usage() {
  cat <<EOF
Usage: $PROGRAM <command> [arguments]

  install                         Configure and start a new installation
  menu                            Open the guided terminal menu (/help to return)
  start | stop | restart | status
  version                         Show the installed release and images
  data                            Show database, app files and backup locations
  setup-token                     Show the one-time first-run setup token
  setup-info                      Show the browser address and setup instructions
  logs [service]                  Follow container logs
  doctor [--fix]                  Check configuration, storage, and services
  backup [archive.tar.gz]         Back up the PostgreSQL database only
  backups                         List available backups
  restore <archive.tar.gz>        Restore the database; keep current files
  rollback                        Restore the latest pre-update backup
  update [release-tag]            Install the latest release on your channel
  channel <stable|nightly>        Select which releases Vueio follows
  updater enable | disable       Enable browser updates and storage on Linux/Mac
  updater status | serve         Inspect or run the host updater
  storage list
  storage add <label> <path> [ro|rw]
  storage reconnect              Recheck registered drives and reconnect them
  storage remove <label> [--yes]
  exposure set <https://url> [--cloudflare]
                                  Prepare Vueio for an HTTPS proxy or tunnel
  exposure local                  Return to local HTTP bootstrap mode

Set VUEIO_HOME to select a different private installation directory.
EOF
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

require_installed() {
  if [[ $(uname -s) == Linux && $(id -u) != 0 && ! -r $ENV_FILE ]]; then
    die "This Linux installation needs administrator access. Run: sudo $PROGRAM"
  fi
  [[ -f "$COMPOSE_FILE" && -f "$ENV_FILE" ]] ||
    die "Vueio is not configured in $VUEIO_HOME. Run '$PROGRAM install' first."
  local state_path
  state_path=$(env_value VUEIO_STATE_PATH)
  [[ -z $state_path ]] || BACKUP_DIR="$state_path/backups"
}

maintenance_lock() {
  require_installed
  # The daemon passes its already-held lock through this exact descriptor.
  if [[ ${VUEIO_MAINTENANCE_FD:-} =~ ^[0-9]+$ ]] &&
    python3 - "$VUEIO_MAINTENANCE_FD" "$VUEIO_HOME/.maintenance.lock" <<'PY'
import fcntl, os, sys
try:
    fd = int(sys.argv[1])
    actual, expected = os.fstat(fd), os.stat(sys.argv[2])
    if (actual.st_dev, actual.st_ino) != (expected.st_dev, expected.st_ino):
        raise ValueError('Wrong lock')
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except (OSError, ValueError):
    raise SystemExit(1)
PY
  then
    return 0
  fi
  if [[ $(uname -s) == Darwin ]]; then
    # fcntl works on both hosts; macOS has no flock command. Hold the same
    # descriptor across exec so CLI and browser operations share one lock.
    local input_fd
    exec {input_fd}<&0
    exec python3 - "$input_fd" "$VUEIO_HOME/.maintenance.lock" "$0" "${ORIGINAL_ARGUMENTS[@]}" <<'PY'
import fcntl, os, sys
os.dup2(int(sys.argv[1]), 0)
os.close(int(sys.argv[1]))
fd = os.open(sys.argv[2], os.O_CREAT | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
try:
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    raise SystemExit('Another host operation is in progress. Wait for it to finish.')
os.set_inheritable(fd, True)
os.environ['VUEIO_MAINTENANCE_FD'] = str(fd)
os.execv(sys.argv[3], sys.argv[3:])
PY
  fi
  require_command flock
  exec {VUEIO_MAINTENANCE_FD}>"$VUEIO_HOME/.maintenance.lock"
  chmod 600 "$VUEIO_HOME/.maintenance.lock"
  flock -n "$VUEIO_MAINTENANCE_FD" || die "Another host operation is in progress. Wait for it to finish."
}

prepare_updater_directory() {
  local pgid
  pgid=$(env_value VUEIO_PGID)
  [[ $pgid =~ ^[0-9]+$ ]] || die "The updater needs a numeric engine group ID"
  [[ ! -L "$VUEIO_HOME/updater" ]] || die "The updater directory must not be a symbolic link"
  mkdir -p "$VUEIO_HOME/updater"
  chmod 750 "$VUEIO_HOME/updater"
  chown "$(id -u):$pgid" "$VUEIO_HOME/updater"
  set_env VUEIO_UPDATER_DIR "$VUEIO_HOME/updater"
  if [[ $(uname -s) == Darwin && ! -f $VUEIO_HOME/updater/access-token ]]; then
    local helper_port
    helper_port=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])')
    (umask 077; random_hex 32 >"$VUEIO_HOME/updater/access-token")
    chmod 640 "$VUEIO_HOME/updater/access-token"
    chown "$(id -u):$pgid" "$VUEIO_HOME/updater/access-token"
    set_env VUEIO_UPDATER_PORT "$helper_port"
    set_env VUEIO_UPDATER_URL "http://host.docker.internal:$helper_port"
    set_env VUEIO_UPDATER_TOKEN_FILE /run/vueio-updater/access-token
  fi
}

validate_release_tag() {
  [[ ${1:-} =~ $RELEASE_TAG_PATTERN ]] ||
    die "Release version must be vX.Y.Z-alpha.N or vX.Y.Z-alpha.N.dev.M without leading zeroes"
}

is_nightly_tag() {
  [[ ${1:-} =~ \.dev\.[0-9]+$ ]]
}

validate_channel() {
  [[ ${1:-} == stable || ${1:-} == nightly ]] ||
    die "Update channel must be 'stable' or 'nightly'"
}

version_key() {
  validate_release_tag "$1"
  [[ $1 =~ $RELEASE_TAG_PATTERN ]]
  printf '%010d%010d%010d%010d%010d\n' \
    "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" \
    "${BASH_REMATCH[4]}" "$([[ -n ${BASH_REMATCH[6]:-} ]] && printf '%s' "${BASH_REMATCH[6]}" || printf '%s' 0)"
}

version_is_newer() {
  [[ $(version_key "$1") > $(version_key "$2") ]]
}

compose() {
  case ${1:-} in up|start|restart) require_data_mount; render_gpu_access ;; esac
  local installation=()
  [[ ! -f "$DATA_COMPOSE_FILE" ]] || installation+=(-f "$DATA_COMPOSE_FILE")
  [[ ! -f "$INSTALLATION_COMPOSE_FILE" ]] || installation+=(-f "$INSTALLATION_COMPOSE_FILE")
  [[ ! -f "$GPU_COMPOSE_FILE" ]] || installation+=(-f "$GPU_COMPOSE_FILE")
  docker compose \
    --env-file "$ENV_FILE" \
    -f "$COMPOSE_FILE" \
    -f "$STORAGE_COMPOSE_FILE" \
    "${installation[@]}" \
    "$@"
}

wait_for_engine() {
  for _ in {1..30}; do
    if compose ps --status running -q vueio_engine 2>/dev/null | grep -q . &&
      compose exec -T vueio_engine python -c \
        "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health/ready', timeout=3).read()" \
        >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  return 1
}

env_value() {
  local key=$1
  sed -n "s/^${key}=//p" "$ENV_FILE" | tail -n 1
}

set_env() {
  local key=$1 value=$2 tmp
  tmp=$(mktemp "$VUEIO_HOME/.env.XXXXXX")
  awk -v key="$key" -v value="$value" '
    BEGIN { found = 0 }
    index($0, key "=") == 1 {
      if (!found) print key "=" value
      found = 1
      next
    }
    { print }
    END { if (!found) print key "=" value }
  ' "$ENV_FILE" >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$ENV_FILE"
}

random_hex() {
  local bytes=${1:-32}
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex "$bytes"
  else
    od -An -N "$bytes" -tx1 /dev/urandom | tr -d ' \n'
  fi
}

validate_port() {
  if [[ ! $1 =~ ^[0-9]+$ ]] || ((10#$1 < 1 || 10#$1 > 65535)); then
    die "Port must be between 1 and 65535"
  fi
}

port_in_use() {
  (exec 3<>"/dev/tcp/127.0.0.1/$1") >/dev/null 2>&1
}

validate_mode() {
  [[ $1 == ro || $1 == rw ]] || die "Storage mode must be 'ro' or 'rw'"
}

validate_label() {
  [[ ${#1} -le 80 && $1 =~ ^[A-Za-z0-9][A-Za-z0-9\ ._-]*$ ]] ||
    die "Labels may contain letters, numbers, spaces, dots, underscores, and dashes"
  [[ $(normalized_storage_label "$1") != data ]] || die "The storage name 'data' is reserved"
}

normalized_storage_label() {
  printf '%s' "$1" |
    tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9_-]+/-/g; s/^-+//; s/-+$//'
}

paths_overlap() {
  [[ $1 == "$2" || $1 == "$2/"* || $2 == "$1/"* ]]
}

validate_storage_path() {
  local path=$1 internal
  if printf '%s' "$path" | LC_ALL=C grep -q '[[:cntrl:]]'; then
    die "Storage paths cannot contain control characters"
  fi
  [[ $path != / ]] || die "The host root cannot be registered as project storage"
  for internal in "$VUEIO_HOME" "${VUEIO_INSTALL_STATE_PATH:-$(env_value VUEIO_STATE_PATH 2>/dev/null || true)}" /dev /proc /sys; do
    [[ -n $internal ]] || continue
    internal=$(realpath -m "$internal")
    if paths_overlap "$path" "$internal"; then
      die "Storage must not overlap Vueio or operating-system internals: $internal"
    fi
  done
  # Desktop Linux commonly mounts removable drives below /run/media.
  [[ $path != /run && ( $path != /run/* || $path == /run/media/*/* ) ]] ||
    die "Storage must not overlap operating-system internals"
}

require_data_mount() {
  local state_path identity
  state_path=$(env_value VUEIO_STATE_PATH)
  [[ -n $state_path ]] || return 0 # Existing named-volume installations stay unchanged.
  if [[ $(env_value VUEIO_DATABASE_INITIALIZING) == true && ${VUEIO_INSTALL_IN_PROGRESS:-false} != true ]]; then
    die "Setup did not complete. Its data and configuration were preserved. Review that installation before starting it; Vueio will not initialize another database."
  fi
  identity=$(env_value VUEIO_STATE_ID)
  storage_marker_matches "$state_path/.vueio-storage-id" "$identity" ||
    die "The Vue data folder is missing or belongs to a different drive. Reconnect the original drive at $state_path. No new database was created."
  [[ -d $state_path/postgres && -d $state_path/app && -f $DATA_COMPOSE_FILE ]] ||
    die "The Vue data folder is incomplete. Restore it from your backup; Vueio will not create an empty replacement."
}

render_gpu_access() {
  # Device access does not enable GPU processing. CPU remains the app default.
  [[ $(uname -s) == Linux ]] || return 0
  python3 - "$GPU_COMPOSE_FILE" <<'PY'
import json, os, pathlib, re, subprocess, sys, tempfile
target = pathlib.Path(sys.argv[1])
if target.exists():
    try:
        if json.loads(target.read_text()).get('x-vueio-generated') != 'gpu-access':
            sys.exit(0)
    except (ValueError, OSError):
        sys.exit(0)  # Preserve operator-managed overrides.
devices = [p for p in sorted(pathlib.Path('/dev/dri').glob('renderD*')) if re.fullmatch(r'renderD[0-9]+', p.name) and p.is_char_device()]
service = {}
if devices:
    service['devices'] = [f'{p}:{p}:rw' for p in devices]
    service['group_add'] = sorted({str(p.stat().st_gid) for p in devices})
try:
    runtimes = json.loads(subprocess.check_output(['docker', 'info', '--format', '{{json .Runtimes}}'], timeout=5))
    if 'nvidia' in runtimes:
        check = subprocess.run(['nvidia-smi', '-L'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
        if check.returncode == 0:
            service['deploy'] = {'resources': {'reservations': {'devices': [{'driver': 'nvidia', 'count': 'all', 'capabilities': ['gpu']}]}}}
            service['environment'] = {'NVIDIA_DRIVER_CAPABILITIES': 'video,compute,utility'}
except (OSError, ValueError, subprocess.SubprocessError):
    pass
if service or target.exists():
    # Refresh generated access when a GPU is removed. Missing hardware must not
    # leave a stale device mount that prevents CPU-only startup.
    with tempfile.NamedTemporaryFile(mode='w', dir=target.parent, delete=False) as handle:
        temporary = pathlib.Path(handle.name)
        json.dump({'x-vueio-generated': 'gpu-access', 'services': {'vueio_engine': service}}, handle)
    try:
        temporary.replace(target)
    finally:
        temporary.unlink(missing_ok=True)
PY
}

show_data_location() {
  require_installed
  local state_path
  state_path=$(env_value VUEIO_STATE_PATH)
  title "Your Vue data"
  if [[ -n $state_path ]]; then
    note "Data folder: $state_path"
    note "Database: $state_path/postgres"
  else
    note "Database: Docker volume $(env_value VUEIO_POSTGRES_VOLUME)"
    note "This existing installation has not been moved."
  fi
  note "App files and previews: $(env_value VUEIO_DATA_PATH)"
  note "Private configuration: $VUEIO_HOME"
  note "Database backups: $BACKUP_DIR"
  note ""
  note "The database holds accounts, comments, projects, members and history."
  note "Use '$PROGRAM backup' for a consistent database backup. Copy it to a separate drive."
  note "Also protect app files, source media and private configuration. Database backups do not include them."
  note "Stop Vueio before copying its live database folder. Never unplug its data drive while Vueio is running."
}

render_data_mount() {
  # Only fresh installations get this override. The base Compose file retains
  # the legacy named volume, so an update cannot relocate an existing database.
  cat >"$DATA_COMPOSE_FILE" <<'EOF'
services:
  vueio_postgres:
    environment:
      PGDATA: /vueio-state/postgres
      VUEIO_STATE_ID: ${VUEIO_STATE_ID:?Missing data identity}
      VUEIO_DATABASE_INITIALIZING: ${VUEIO_DATABASE_INITIALIZING:-false}
    entrypoint:
      - /bin/sh
      - -ec
      - |
        test ! -L /vueio-state/.vueio-storage-id
        test "$$(cat /vueio-state/.vueio-storage-id)" = "$$VUEIO_STATE_ID" || { echo 'The original Vue data drive is not connected.' >&2; exit 1; }
        test -f "$$PGDATA/PG_VERSION" || test "$$VUEIO_DATABASE_INITIALIZING" = true || { echo 'The Vue database is missing. Restore it; an empty replacement will not be created.' >&2; exit 1; }
        exec docker-entrypoint.sh postgres
    volumes:
      - type: bind
        source: ${VUEIO_STATE_PATH:?Missing data folder}
        target: /vueio-state
        bind:
          create_host_path: false
  vueio_engine:
    environment:
      VUEIO_HOST_STATE_PATH: ${VUEIO_STATE_PATH}
      VUEIO_HOST_CONFIG_PATH: ${VUEIO_HOME_PATH}
EOF
}

yaml_quote() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  # Compose interpolates dollars even inside quoted YAML strings.
  value=${value//\$/\$\$}
  printf '"%s"' "$value"
}

storage_records() {
  local extension=${1:-root}
  [[ -d "$STORAGE_DIR" ]] || return 0
  find "$STORAGE_DIR" -maxdepth 1 -type f -name "*.$extension" -print0 |
    sort -z |
    while IFS= read -r -d '' record; do
      local id label path mode sentinel
      id=${record##*/}
      id=${id%.*}
      {
        IFS= read -r label
        IFS= read -r path
        IFS= read -r mode
        IFS= read -r sentinel || true
      } <"$record"
      printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$label" "$path" "$mode" "$sentinel"
    done
}

storage_marker_matches() {
  local marker=$1 expected=$2 actual
  [[ ! -L $marker && -f $marker ]] || return 1
  actual=$(
    dd if="$marker" iflag=nofollow,nonblock bs=256 count=1 status=none 2>/dev/null
  ) || return 1
  [[ $actual == "$expected" ]]
}

require_storage_mounts() {
  local _id label path _mode sentinel marker
  while IFS=$'\t' read -r _id label path _mode sentinel; do
    marker="$path/.vueio-storage-id"
    [[ $sentinel =~ ^[a-f0-9]{32,128}$ ]] || die "Storage '$label' has an invalid identity record. Check its configuration on the host."
    if [[ ! -d $path ]] || ! storage_marker_matches "$marker" "$sentinel"; then
      if [[ -f $INSTALLATION_COMPOSE_FILE ]]; then
        die "Storage '$label' is offline. This installation has custom mounts; reconnect the expected drive before starting Vueio."
      fi
      warn "Storage '$label' is offline. Its projects are kept, but its files cannot be opened until it is reconnected."
    fi
  done < <(storage_records)
  [[ -f $INSTALLATION_COMPOSE_FILE ]] || render_storage
}

render_storage() {
  local tmp roots first record id label path mode sentinel mounted=false
  local -a records=()
  mapfile -t records < <(storage_records)
  for record in "${records[@]}"; do
    IFS=$'\t' read -r id label path mode sentinel <<<"$record"
    [[ -n ${id:-} ]] || continue
    [[ $sentinel =~ ^[a-f0-9]{32,128}$ ]] ||
      die "Storage '$label' has no valid identity marker recorded. Remove and re-add it after preparing $path/.vueio-storage-id."
  done

  tmp=$(mktemp "$VUEIO_HOME/compose.storage.XXXXXX")
  roots='{'
  first=true
  {
    printf 'services:\n'
    printf '  vueio_engine:\n'
    for record in "${records[@]}"; do
      IFS=$'\t' read -r id label path mode sentinel <<<"$record"
      [[ -n ${id:-} ]] || continue
      # Keep every identity in the catalog, but never mount a missing drive's
      # empty mountpoint (or a different disk that reused its name). /storage
      # is a read-only tmpfs in the base Compose file, so writes fail closed.
      if storage_marker_matches "$path/.vueio-storage-id" "$sentinel"; then
        if [[ $mounted == false ]]; then
          printf '    volumes:\n'
          mounted=true
        fi
        printf '      - type: bind\n'
        printf '        source: %s\n' "$(yaml_quote "$path")"
        printf '        target: /storage/root-%s\n' "$id"
        [[ $mode == ro ]] && printf '        read_only: true\n' || printf '        read_only: false\n'
        printf '        bind:\n'
        printf '          create_host_path: false\n'
      fi
      if [[ $first == true ]]; then
        first=false
      else
        roots+=','
      fi
      roots+="\"$label\":{\"path\":\"/storage/root-$id\",\"sentinel\":\"$sentinel\"}"
    done
    [[ $mounted == true ]] || printf '    volumes: []\n'
  } >"$tmp"
  roots+='}'
  mv "$tmp" "$STORAGE_COMPOSE_FILE"
  set_env VUEIO_PROJECT_STORAGE_ROOTS "$roots"
}

next_storage_id() {
  local max=0 id
  while IFS=$'\t' read -r id _; do
    [[ $id =~ ^[0-9]+$ ]] || continue
    ((10#$id > max)) && max=$((10#$id))
  done < <(storage_records; storage_records removed)
  printf '%03d\n' "$((max + 1))"
}

verify_storage_connection() {
  compose exec -T vueio_engine python - "$(normalized_storage_label "$1")" "${2:-ro}" <<'PY' ||
import sys
from app.services.projects import configured_project_storage_catalog, storage_root_is_available, storage_location_is_read_only

item = configured_project_storage_catalog().get(sys.argv[1])
ready = item is not None and storage_root_is_available(item)
if ready and sys.argv[2] == 'rw':
    ready = not storage_location_is_read_only(item['path'])
raise SystemExit(0 if ready else 1)
PY
    die "The connection was saved, but Vueio cannot access the expected drive. Check Storage in Settings and the drive's permissions on this computer."
}

storage_add() {
  [[ ! -f "$INSTALLATION_COMPOSE_FILE" ]] || die "This installation has host-specific overrides. Review its storage mapping on the host before adding storage."
  local label=${1:-} path=${2:-} mode=${3:-rw} id record sentinel sentinel_file normalized_label retired_id='' record_tmp
  local marker_created=false duplicate=false
  [[ -n $label && -n $path ]] || die "Usage: $PROGRAM storage add <label> <path> [ro|rw]"
  validate_label "$label"
  validate_mode "$mode"
  [[ -d "$path" ]] || die "Storage path does not exist or is not a directory: $path"
  path=$(realpath "$path")
  validate_storage_path "$path"
  if [[ -n ${VUEIO_STORAGE_DEVICE_ID:-} ]]; then
    # The web picker can select a mounted device, never supply arbitrary host
    # paths. Recheck after the asynchronous handoff from the host helper.
    python3 "$UPDATER_FILE" --home "$VUEIO_HOME" --check-drive "$VUEIO_STORAGE_DEVICE_ID" "$path" ||
      die "The selected drive changed. Check for drives again before connecting it."
  fi
  normalized_label=$(normalized_storage_label "$label")
  while IFS=$'\t' read -r _ existing_label existing_path _ _; do
    [[ $existing_label != "$label" ]] || die "A storage root named '$label' already exists"
    [[ $(normalized_storage_label "$existing_label") != "$normalized_label" ]] ||
      die "Storage labels must remain distinct after normalization: '$existing_label' and '$label'"
    if paths_overlap "$existing_path" "$path"; then
      die "Storage roots cannot overlap: $existing_path"
    fi
  done < <(storage_records)

  # A removed name must not silently point existing database records at an
  # unrelated disk. The original drive can reclaim its name and mount ID.
  while IFS=$'\t' read -r existing_id existing_label _ _ existing_sentinel; do
    if [[ $(normalized_storage_label "$existing_label") == "$normalized_label" ]]; then
      storage_marker_matches "$path/.vueio-storage-id" "$existing_sentinel" ||
        die "This storage name belongs to a disconnected drive. Reconnect the original drive or choose a new name."
      retired_id=$existing_id
      break
    fi
  done < <(storage_records removed)

  sentinel_file="$path/.vueio-storage-id"
  if [[ -L $sentinel_file ]]; then
    die "Storage identity marker must not be a symbolic link: $sentinel_file"
  elif [[ -e $sentinel_file ]]; then
    [[ -f $sentinel_file ]] ||
      die "Storage identity marker must be a regular file: $sentinel_file"
    sentinel=$(
      dd if="$sentinel_file" iflag=nofollow,nonblock bs=256 count=1 status=none 2>/dev/null
    ) || die "Vueio could not safely read the storage identity marker: $sentinel_file"
    [[ $sentinel =~ ^[a-f0-9]{32,128}$ ]] ||
      die "Storage sentinel is invalid: $sentinel_file"
  else
    while :; do
      sentinel=$(random_hex 24)
      duplicate=false
      while IFS=$'\t' read -r _ _ _ _ existing_sentinel; do
        if [[ -n $existing_sentinel && $existing_sentinel == "$sentinel" ]]; then
          duplicate=true
          break
        fi
      done < <(storage_records)
      [[ $duplicate == false ]] && break
    done

    # O_EXCL works on exFAT/FAT USB drives, unlike hard links. It also refuses
    # to overwrite another installation's marker or follow a symbolic link.
    python3 - "$sentinel_file" "$sentinel" <<'PY' || die "Could not create the drive identity marker. Check write access and try again."
import os
import sys

path, token = sys.argv[1:]
descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o444)
identity = os.fstat(descriptor)
try:
    with os.fdopen(descriptor, 'wb') as handle:
        handle.write((token + '\n').encode('ascii'))
        handle.flush()
        # The host service uses umask 0077. The non-root media engine must
        # still be able to read this identity (it is not a secret).
        os.fchmod(handle.fileno(), 0o444)
        os.fsync(handle.fileno())
except BaseException:
    # Only this newly-created marker is removed, never existing media.
    try:
        current = os.stat(path, follow_symlinks=False)
        if (current.st_dev, current.st_ino) == (identity.st_dev, identity.st_ino):
            os.unlink(path)
    except FileNotFoundError:
        pass
    raise
PY
    marker_created=true
    if [[ ${VUEIO_INSTALL_IN_PROGRESS:-false} == true ]]; then
      VUEIO_INSTALL_CREATED_STORAGE_MARKER=$sentinel_file
      VUEIO_INSTALL_CREATED_STORAGE_SENTINEL=$sentinel
    fi
  fi
  [[ -r $sentinel_file ]] ||
    die "Storage identity marker is not readable: $sentinel_file"

  while IFS=$'\t' read -r _ existing_label _ _ existing_sentinel; do
    if [[ -n $existing_sentinel && $existing_sentinel == "$sentinel" ]]; then
      if [[ $marker_created == true ]]; then
        rm -f -- "$sentinel_file"
      fi
      die "Storage identity marker is already registered as '$existing_label'; create a distinct storage root marker"
    fi
  done < <(storage_records)

  id=${retired_id:-$(next_storage_id)}
  record="$STORAGE_DIR/$id.root"
  record_tmp=$(mktemp "$STORAGE_DIR/.add.XXXXXX")
  printf '%s\n%s\n%s\n%s\n' "$label" "$path" "$mode" "$sentinel" >"$record_tmp"
  mv -- "$record_tmp" "$record"
  [[ -z $retired_id ]] || rm -f -- "$STORAGE_DIR/$retired_id.removed"
  render_storage
  note "Added '$label' ($mode): $path"
  if compose ps -q vueio_engine 2>/dev/null | grep -q .; then
    note "Applying storage changes requires a brief Vueio restart."
    compose up -d --no-deps --force-recreate vueio_engine vueio_ui
    wait_for_engine || die "Storage was registered, but Vueio has not restarted. Run '$PROGRAM doctor' on the host."
    verify_storage_connection "$label" "$mode"
  fi
}

storage_reconnect() {
  (($# == 0 || $# == 2)) || die "Usage: $PROGRAM storage reconnect [label path]"
  [[ ! -f "$INSTALLATION_COMPOSE_FILE" ]] || die "This installation has custom mounts. Reconnect its storage on the host."
  if (($# == 2)); then
    local label=$1 path=$2 id existing_label existing_path mode sentinel record='' tmp
    [[ -d $path ]] || die "The original drive is not connected"
    path=$(realpath "$path")
    validate_storage_path "$path"
    while IFS=$'\t' read -r id existing_label existing_path mode sentinel; do
      if [[ $existing_label == "$label" ]]; then
        if [[ $path != "$existing_path" ]] && storage_marker_matches "$existing_path/.vueio-storage-id" "$sentinel"; then
          die "The original drive is still connected. Vueio will not replace it with another copy."
        fi
        storage_marker_matches "$path/.vueio-storage-id" "$sentinel" || die "This is not the original drive"
        record="$STORAGE_DIR/$id.root"
        tmp=$(mktemp "$STORAGE_DIR/.reconnect.XXXXXX")
        printf '%s\n%s\n%s\n%s\n' "$label" "$path" "$mode" "$sentinel" >"$tmp"
      elif paths_overlap "$existing_path" "$path"; then
        [[ -z ${tmp:-} ]] || rm -f -- "$tmp"
        die "This path overlaps another registered storage location"
      fi
    done < <(storage_records)
    [[ -n $record ]] || die "This storage location is not registered"
    mv -- "$tmp" "$record"
  fi
  require_storage_mounts
  compose up -d --no-deps --force-recreate vueio_engine vueio_ui
  wait_for_engine || die "Vueio has not restarted. Run '$PROGRAM doctor' on the host."
  if (($# == 2)); then verify_storage_connection "$1"; fi
}

storage_list() {
  local found=false
  printf '%-4s  %-24s  %-4s  %s\n' ID LABEL MODE HOST_PATH
  while IFS=$'\t' read -r id label path mode _; do
    found=true
    printf '%-4s  %-24s  %-4s  %s\n' "$id" "$label" "$mode" "$path"
  done < <(storage_records)
  [[ $found == true ]] || note "(no storage roots configured)"
}

storage_remove() {
  [[ ! -f "$INSTALLATION_COMPOSE_FILE" ]] || die "This installation has host-specific overrides. Review its storage mapping on the host before removing storage."
  local label=${1:-} confirm=${2:-} record=
  [[ -n $label ]] || die "Usage: $PROGRAM storage remove <label> [--yes]"
  while IFS=$'\t' read -r id existing_label _ _ _; do
    if [[ $existing_label == "$label" ]]; then
      record="$STORAGE_DIR/$id.root"
      break
    fi
  done < <(storage_records)
  [[ -n $record ]] || die "No storage root named '$label'"

  if [[ $confirm != --yes && ${VUEIO_NONINTERACTIVE:-0} != 1 ]]; then
    printf "Remove '%s' from Vueio? Files will not be deleted, but projects there will be offline. [y/N] " "$label"
    read -r confirm
    [[ $confirm == y || $confirm == Y ]] || return 0
  elif [[ $confirm != --yes && ${VUEIO_NONINTERACTIVE:-0} == 1 ]]; then
    die "Pass --yes when removing storage non-interactively"
  fi

  mv -- "$record" "${record%.root}.removed"
  render_storage
  note "Removed '$label'. No source files were changed."
  if compose ps -q vueio_engine 2>/dev/null | grep -q .; then
    note "Applying storage changes requires a brief Vueio restart."
    compose up -d --no-deps --force-recreate vueio_engine vueio_ui
    doctor
  fi
}

show_version() {
