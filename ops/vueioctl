#!/usr/bin/env bash
set -Eeuo pipefail

PROGRAM=${0##*/}
SCRIPT_DIR=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
VUEIO_HOME=${VUEIO_HOME:-/opt/vueio}
COMPOSE_FILE="$VUEIO_HOME/compose.yml"
STORAGE_COMPOSE_FILE="$VUEIO_HOME/compose.storage.yml"
ENV_FILE="$VUEIO_HOME/.env"
STORAGE_DIR="$VUEIO_HOME/storage.d"
BACKUP_DIR="$VUEIO_HOME/backups"
LOG_DIR="$VUEIO_HOME/logs"
UPDATE_STATE_FILE="$VUEIO_HOME/.update-state"
LICENSE_FILE="$VUEIO_HOME/LICENSE.md"
RELEASE_TAG_PATTERN='^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)-alpha\.(0|[1-9][0-9]*)(\.dev\.(0|[1-9][0-9]*))?$'

if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
  RESET=$'\033[0m'
  BOLD=$'\033[1m'
  GREEN=$'\033[32m'
  MINT=$'\033[38;5;121m'
  YELLOW=$'\033[33m'
else
  RESET=
  BOLD=
  GREEN=
  MINT=
  YELLOW=
fi

die() {
  printf '%sError:%s %s\n' "$BOLD" "$RESET" "$*" >&2
  exit 1
}

note() {
  printf '%s\n' "$*"
}

warn() {
  printf '%s!%s %s\n' "$YELLOW" "$RESET" "$*" >&2
}

title() {
  printf '\n%s%s%s%s\n' "$BOLD" "$MINT" "$*" "$RESET"
}

step() {
  printf '%s→%s %s\n' "$MINT" "$RESET" "$*"
}

success() {
  printf '%s✓%s %s\n' "$GREEN" "$RESET" "$*"
}

confirm() {
  local answer
  printf '%s [Y/n] ' "$1"
  read -r answer
  [[ -z $answer || $answer == y || $answer == Y || $answer == yes || $answer == YES ]]
}

[[ $VUEIO_HOME = /* && $VUEIO_HOME != / ]] ||
  die "VUEIO_HOME must be an absolute directory other than /"

usage() {
  cat <<EOF
Usage: $PROGRAM <command> [arguments]

  install                         Configure and start a new installation
  start | stop | restart | status
  version                         Show the installed release and images
  setup-token                    Show the one-time first-run setup token
  logs [service]                  Follow container logs
  doctor [--fix]                  Check configuration, storage, and services
  backup [archive.tar.gz]         Back up Vueio state (not source media)
  backups                         List available backups
  restore <archive.tar.gz>        Restore Vueio state after confirmation
  rollback                        Restore the latest pre-update backup
  update <release-tag>            Back up, refresh release files, and update
  channel <stable|nightly>        Select which releases Vueio follows
  storage list
  storage add <label> <path> [ro|rw]
  storage remove <label> [--yes]
  exposure set <https://url> [--cloudflare]
                                  Prepare Vueio for an HTTPS proxy or tunnel
  exposure local                  Return to local HTTP bootstrap mode

Set VUEIO_HOME to use a location other than /opt/vueio.
EOF
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

require_installed() {
  [[ -f "$COMPOSE_FILE" && -f "$ENV_FILE" ]] ||
    die "Vueio is not configured in $VUEIO_HOME. Run '$PROGRAM install' first."
}

validate_release_tag() {
  [[ ${1:-} =~ $RELEASE_TAG_PATTERN ]] ||
    die "Release version must be vX.Y.Z-alpha.N or vX.Y.Z-alpha.N.dev.M without leading zeroes"
}

is_nightly_tag() {
  [[ ${1:-} =~ \.dev\.[0-9]+$ ]]
}

validate_channel() {
  [[ ${1:-} == stable || ${1:-} == nightly ]] ||
    die "Update channel must be 'stable' or 'nightly'"
}

version_key() {
  validate_release_tag "$1"
  [[ $1 =~ $RELEASE_TAG_PATTERN ]]
  printf '%010d%010d%010d%010d%010d\n' \
    "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" \
    "${BASH_REMATCH[4]}" "$([[ -n ${BASH_REMATCH[6]:-} ]] && printf '%s' "${BASH_REMATCH[6]}" || printf '%s' 0)"
}

version_is_newer() {
  [[ $(version_key "$1") > $(version_key "$2") ]]
}

compose() {
  docker compose \
    --env-file "$ENV_FILE" \
    -f "$COMPOSE_FILE" \
    -f "$STORAGE_COMPOSE_FILE" \
    "$@"
}

wait_for_engine() {
  for _ in {1..30}; do
    if compose ps --status running -q vueio_engine 2>/dev/null | grep -q . &&
      compose exec -T vueio_engine python -c \
        "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health/ready', timeout=3).read()" \
        >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  return 1
}

env_value() {
  local key=$1
  sed -n "s/^${key}=//p" "$ENV_FILE" | tail -n 1
}

set_env() {
  local key=$1 value=$2 tmp
  tmp=$(mktemp "$VUEIO_HOME/.env.XXXXXX")
  awk -v key="$key" -v value="$value" '
    BEGIN { found = 0 }
    index($0, key "=") == 1 {
      if (!found) print key "=" value
      found = 1
      next
    }
    { print }
    END { if (!found) print key "=" value }
  ' "$ENV_FILE" >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$ENV_FILE"
}

random_hex() {
  local bytes=${1:-32}
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex "$bytes"
  else
    od -An -N "$bytes" -tx1 /dev/urandom | tr -d ' \n'
  fi
}

validate_port() {
  if [[ ! $1 =~ ^[0-9]+$ ]] || ((10#$1 < 1 || 10#$1 > 65535)); then
    die "Port must be between 1 and 65535"
  fi
}

port_in_use() {
  (exec 3<>"/dev/tcp/127.0.0.1/$1") >/dev/null 2>&1
}

validate_mode() {
  [[ $1 == ro || $1 == rw ]] || die "Storage mode must be 'ro' or 'rw'"
}

validate_label() {
  [[ -n $1 && $1 =~ ^[[:alnum:]][[:alnum:]\ ._-]*$ ]] ||
    die "Labels may contain letters, numbers, spaces, dots, underscores, and dashes"
}

normalized_storage_label() {
  printf '%s' "$1" |
    tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9_-]+/-/g; s/^-+//; s/-+$//'
}

paths_overlap() {
  [[ $1 == "$2" || $1 == "$2/"* || $2 == "$1/"* ]]
}

validate_storage_path() {
  local path=$1 internal
  if printf '%s' "$path" | LC_ALL=C grep -q '[[:cntrl:]]'; then
    die "Storage paths cannot contain control characters"
  fi
  [[ $path != / ]] || die "The host root cannot be registered as project storage"
  for internal in "$VUEIO_HOME" /dev /proc /run /sys; do
    internal=$(realpath -m "$internal")
    if paths_overlap "$path" "$internal"; then
      die "Storage must not overlap Vueio or operating-system internals: $internal"
    fi
  done
}

yaml_quote() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  # Compose interpolates dollars even inside quoted YAML strings.
  value=${value//\$/\$\$}
  printf '"%s"' "$value"
}

storage_records() {
  [[ -d "$STORAGE_DIR" ]] || return 0
  find "$STORAGE_DIR" -maxdepth 1 -type f -name '*.root' -print0 |
    sort -z |
    while IFS= read -r -d '' record; do
      local id label path mode sentinel
      id=${record##*/}
      id=${id%.root}
      {
        IFS= read -r label
        IFS= read -r path
        IFS= read -r mode
        IFS= read -r sentinel || true
      } <"$record"
      printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$label" "$path" "$mode" "$sentinel"
    done
}

storage_marker_matches() {
  local marker=$1 expected=$2 actual
  [[ ! -L $marker && -f $marker ]] || return 1
  actual=$(
    dd if="$marker" iflag=nofollow,nonblock bs=256 count=1 status=none 2>/dev/null
  ) || return 1
  [[ $actual == "$expected" ]]
}

require_storage_mounts() {
  local _id label path _mode sentinel marker
  while IFS=$'\t' read -r _id label path _mode sentinel; do
    marker="$path/.vueio-storage-id"
    if [[ ! -d $path || ! $sentinel =~ ^[a-f0-9]{32,128}$ ]] ||
      ! storage_marker_matches "$marker" "$sentinel"; then
      die "Storage '$label' is unavailable or mounted with a different identity. Reconnect the expected filesystem before starting Vueio."
    fi
  done < <(storage_records)
}

render_storage() {
  local tmp roots first record id label path mode sentinel
  local -a records=()
  mapfile -t records < <(storage_records)
  for record in "${records[@]}"; do
    IFS=$'\t' read -r id label path mode sentinel <<<"$record"
    [[ -n ${id:-} ]] || continue
    [[ $sentinel =~ ^[a-f0-9]{32,128}$ ]] ||
      die "Storage '$label' has no valid identity marker recorded. Remove and re-add it after preparing $path/.vueio-storage-id."
  done

  tmp=$(mktemp "$VUEIO_HOME/compose.storage.XXXXXX")
  roots='{'
  first=true
  {
    printf 'services:\n'
    printf '  vueio_engine:\n'
    if ((${#records[@]} == 0)); then
      printf '    volumes: []\n'
    else
      printf '    volumes:\n'
    fi
    for record in "${records[@]}"; do
      IFS=$'\t' read -r id label path mode sentinel <<<"$record"
      [[ -n ${id:-} ]] || continue
      printf '      - type: bind\n'
      printf '        source: %s\n' "$(yaml_quote "$path")"
      printf '        target: /storage/root-%s\n' "$id"
      if [[ $mode == ro ]]; then
        printf '        read_only: true\n'
      else
        printf '        read_only: false\n'
      fi
      printf '        bind:\n'
      printf '          create_host_path: false\n'
      if [[ $first == true ]]; then
        first=false
      else
        roots+=','
      fi
      roots+="\"$label\":{\"path\":\"/storage/root-$id\",\"sentinel\":\"$sentinel\"}"
    done
  } >"$tmp"
  roots+='}'
  mv "$tmp" "$STORAGE_COMPOSE_FILE"
  set_env VUEIO_PROJECT_STORAGE_ROOTS "$roots"
}

next_storage_id() {
  local max=0 id
  while IFS=$'\t' read -r id _; do
    [[ $id =~ ^[0-9]+$ ]] || continue
    ((10#$id > max)) && max=$((10#$id))
  done < <(storage_records)
  printf '%03d\n' "$((max + 1))"
}

storage_add() {
  local label=${1:-} path=${2:-} mode=${3:-rw} id record sentinel sentinel_file sentinel_tmp normalized_label
  local marker_created=false duplicate=false
  [[ -n $label && -n $path ]] || die "Usage: $PROGRAM storage add <label> <path> [ro|rw]"
  validate_label "$label"
  validate_mode "$mode"
  [[ -d "$path" ]] || die "Storage path does not exist or is not a directory: $path"
  path=$(realpath "$path")
  validate_storage_path "$path"
  normalized_label=$(normalized_storage_label "$label")
  while IFS=$'\t' read -r _ existing_label existing_path _ _; do
    [[ $existing_label != "$label" ]] || die "A storage root named '$label' already exists"
    [[ $(normalized_storage_label "$existing_label") != "$normalized_label" ]] ||
      die "Storage labels must remain distinct after normalization: '$existing_label' and '$label'"
    if paths_overlap "$existing_path" "$path"; then
      die "Storage roots cannot overlap: $existing_path"
    fi
  done < <(storage_records)

  sentinel_file="$path/.vueio-storage-id"
  if [[ -L $sentinel_file ]]; then
    die "Storage identity marker must not be a symbolic link: $sentinel_file"
  elif [[ -e $sentinel_file ]]; then
    [[ -f $sentinel_file ]] ||
      die "Storage identity marker must be a regular file: $sentinel_file"
    sentinel=$(
      dd if="$sentinel_file" iflag=nofollow,nonblock bs=256 count=1 status=none 2>/dev/null
    ) || die "Vueio could not safely read the storage identity marker: $sentinel_file"
    [[ $sentinel =~ ^[a-f0-9]{32,128}$ ]] ||
      die "Storage sentinel is invalid: $sentinel_file"
  else
    while :; do
      sentinel=$(random_hex 24)
      duplicate=false
      while IFS=$'\t' read -r _ _ _ _ existing_sentinel; do
        if [[ -n $existing_sentinel && $existing_sentinel == "$sentinel" ]]; then
          duplicate=true
          break
        fi
      done < <(storage_records)
      [[ $duplicate == false ]] && break
    done

    sentinel_tmp=$(mktemp "$path/.vueio-storage-id.XXXXXX") ||
      die "Vueio could not prepare a storage identity marker in: $path"
    if ! printf '%s\n' "$sentinel" >"$sentinel_tmp" ||
      ! chmod 0444 "$sentinel_tmp"; then
      rm -f -- "$sentinel_tmp"
      die "Vueio could not prepare the storage identity marker: $sentinel_file"
    fi
    if ! ln -- "$sentinel_tmp" "$sentinel_file" 2>/dev/null; then
      rm -f -- "$sentinel_tmp"
      if [[ -e $sentinel_file || -L $sentinel_file ]]; then
        die "Storage identity marker appeared while storage was being added; verify it and retry: $sentinel_file"
      fi
      die "Vueio could not atomically create the storage identity marker: $sentinel_file"
    fi
    rm -f -- "$sentinel_tmp"
    marker_created=true
    if [[ ${VUEIO_INSTALL_IN_PROGRESS:-false} == true ]]; then
      VUEIO_INSTALL_CREATED_STORAGE_MARKER=$sentinel_file
      VUEIO_INSTALL_CREATED_STORAGE_SENTINEL=$sentinel
    fi
  fi
  [[ -r $sentinel_file ]] ||
    die "Storage identity marker is not readable: $sentinel_file"

  while IFS=$'\t' read -r _ existing_label _ _ existing_sentinel; do
    if [[ -n $existing_sentinel && $existing_sentinel == "$sentinel" ]]; then
      if [[ $marker_created == true ]]; then
        rm -f -- "$sentinel_file"
      fi
      die "Storage identity marker is already registered as '$existing_label'; create a distinct storage root marker"
    fi
  done < <(storage_records)

  id=$(next_storage_id)
  record="$STORAGE_DIR/$id.root"
  printf '%s\n%s\n%s\n%s\n' "$label" "$path" "$mode" "$sentinel" >"$record"
  chmod 600 "$record"
  render_storage
  note "Added '$label' ($mode): $path"
  if compose ps -q vueio_engine 2>/dev/null | grep -q .; then
    note "Applying storage changes requires a brief Vueio restart."
    compose up -d --no-deps --force-recreate vueio_engine vueio_ui
    doctor
  fi
}

storage_list() {
  local found=false
  printf '%-4s  %-24s  %-4s  %s\n' ID LABEL MODE HOST_PATH
  while IFS=$'\t' read -r id label path mode _; do
    found=true
    printf '%-4s  %-24s  %-4s  %s\n' "$id" "$label" "$mode" "$path"
  done < <(storage_records)
  [[ $found == true ]] || note "(no storage roots configured)"
}

storage_remove() {
  local label=${1:-} confirm=${2:-} record=
  [[ -n $label ]] || die "Usage: $PROGRAM storage remove <label> [--yes]"
  while IFS=$'\t' read -r id existing_label _ _ _; do
    if [[ $existing_label == "$label" ]]; then
      record="$STORAGE_DIR/$id.root"
      break
    fi
  done < <(storage_records)
  [[ -n $record ]] || die "No storage root named '$label'"

  if [[ $confirm != --yes && ${VUEIO_NONINTERACTIVE:-0} != 1 ]]; then
    printf "Remove '%s' from Vueio? Files will not be deleted, but projects there will be offline. [y/N] " "$label"
    read -r confirm
    [[ $confirm == y || $confirm == Y ]] || return 0
  elif [[ $confirm != --yes && ${VUEIO_NONINTERACTIVE:-0} == 1 ]]; then
    die "Pass --yes when removing storage non-interactively"
  fi

  rm -f "$record"
  render_storage
  note "Removed '$label'. No source files were changed."
  if compose ps -q vueio_engine 2>/dev/null | grep -q .; then
    note "Applying storage changes requires a brief Vueio restart."
    compose up -d --no-deps --force-recreate vueio_engine vueio_ui
    doctor
  fi
}

show_version() {
  require_installed
  note "Vueio release: $(env_value VUEIO_VERSION)"
  note "Update channel: $(env_value VUEIO_CHANNEL || printf stable)"
  note "Engine image: $(env_value VUEIO_ENGINE_IMAGE)"
  note "UI image: $(env_value VUEIO_UI_IMAGE)"
}

set_channel() {
  require_installed
  local next=${1:-} current
  validate_channel "$next"
  current=$(env_value VUEIO_CHANNEL)
  current=${current:-stable}
  if [[ $current == "$next" ]]; then
    note "Vueio is already on the $next channel."
  else
    set_env VUEIO_CHANNEL "$next"
  fi
  if compose ps --status running -q vueio_engine 2>/dev/null | grep -q .; then
    step "Applying the $next channel…"
    compose up -d --no-deps vueio_engine
    wait_for_engine || die "Vueio did not become ready after changing the update channel"
  fi
  if [[ $current == stable && $next == nightly ]]; then
    note "Vueio now follows the nightly channel. Check Updates or run the suggested update command when a newer nightly is available."
  elif [[ $current == nightly && $next == stable ]]; then
    note "Vueio now follows the stable channel. Your installed nightly will stay in place until a newer stable release is published. Database migrations are one-way, so switching channels never downgrades the running version."
  fi
}

show_setup_token() {
  require_installed
  note "$(env_value VUEIO_SETUP_TOKEN)"
}

install_vueio() {
  require_command docker
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required"
  docker info >/dev/null 2>&1 || die "Docker is installed but is not running"

  local source_compose source_license version channel port bind local_url puid pgid default_uid default_gid
  local initial_path initial_label initial_mode default_initial_path candidate
  local compose_project postgres_volume
  local create_initial_path=false port_was_explicit=false
  source_compose=${VUEIO_RELEASE_COMPOSE:-"$SCRIPT_DIR/../compose.release.yml"}
  source_license=${VUEIO_RELEASE_LICENSE:-"$SCRIPT_DIR/../LICENSE.md"}
  version=${VUEIO_VERSION:-}
  validate_release_tag "$version"
  channel=${VUEIO_CHANNEL:-stable}
  if [[ ${VUEIO_NONINTERACTIVE:-0} != 1 && -z ${VUEIO_CHANNEL:-} ]]; then
    title "Update channel"
    note "Stable receives reviewed releases. Nightly receives newer test builds too."
    printf 'Channel [stable]: '
    read -r channel
    channel=${channel:-stable}
  fi
  validate_channel "$channel"
  if [[ $channel == stable ]] && is_nightly_tag "$version"; then
    die "A nightly release requires VUEIO_CHANNEL=nightly"
  fi
  [[ -f "$source_compose" ]] || die "compose.release.yml was not found beside this release"
  [[ -f "$source_license" ]] || die "LICENSE.md was not found beside this release"

  [[ -n ${VUEIO_UI_PORT:-} || -n ${VUEIO_LOCAL_URL:-} ]] && port_was_explicit=true
  port=${VUEIO_UI_PORT:-9000}
  bind=${VUEIO_BIND_ADDRESS:-127.0.0.1}
  validate_port "$port"
  if port_in_use "$port"; then
    if [[ $port_was_explicit == true ]]; then
      die "Port $port is already in use. Choose another with VUEIO_UI_PORT."
    fi
    for candidate in {9001..9010}; do
      if ! port_in_use "$candidate"; then
        warn "Port 9000 is busy, so Vueio will use port $candidate."
        port=$candidate
        break
      fi
    done
    port_in_use "$port" && die "Ports 9000 through 9010 are already in use. Set VUEIO_UI_PORT to an available port."
  fi
  default_uid=$(id -u)
  default_gid=$(id -g)
  if [[ $default_uid == 0 ]]; then
    default_uid=1000
    default_gid=1000
  fi
  puid=${VUEIO_PUID:-${SUDO_UID:-$default_uid}}
  pgid=${VUEIO_PGID:-${SUDO_GID:-$default_gid}}
  [[ $puid =~ ^[0-9]+$ && $pgid =~ ^[0-9]+$ ]] || die "PUID and PGID must be numeric"
  local_url=${VUEIO_LOCAL_URL:-http://127.0.0.1:$port}
  compose_project=${VUEIO_COMPOSE_PROJECT:-vueio}
  postgres_volume=${VUEIO_POSTGRES_VOLUME:-${compose_project}_postgres_data}
  [[ $compose_project =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]] ||
    die "VUEIO_COMPOSE_PROJECT contains unsupported characters"

  title "Vueio setup"
  note "This will install Vueio $version with its own database and private configuration."

  default_initial_path=${VUEIO_DEFAULT_STORAGE_PATH:-/var/lib/vueio/projects}
  initial_path=${VUEIO_INITIAL_STORAGE_PATH:-}
  initial_label=${VUEIO_INITIAL_STORAGE_LABEL:-Projects}
  initial_mode=${VUEIO_INITIAL_STORAGE_MODE:-rw}
  if [[ -z $initial_path && ${VUEIO_NONINTERACTIVE:-0} != 1 ]]; then
    title "Project storage"
    note "This is where Vueio will keep original project files."
    note "Press Enter to use the safe local default, or enter an existing mounted folder."
    printf 'Storage folder [%s]: ' "$default_initial_path"
    read -r initial_path
    initial_path=${initial_path:-$default_initial_path}
  elif [[ -z $initial_path ]]; then
    die "Set VUEIO_INITIAL_STORAGE_PATH for a non-interactive installation"
  fi
  validate_label "$initial_label"
  validate_mode "$initial_mode"
  if [[ -d $initial_path ]]; then
    initial_path=$(realpath "$initial_path")
  elif [[ $initial_path == "$default_initial_path" && ${VUEIO_NONINTERACTIVE:-0} != 1 ]]; then
    initial_path=$(realpath -m "$initial_path")
    create_initial_path=true
  else
    die "Storage folder does not exist: $initial_path. Create or mount it first, then run the installer again."
  fi
  validate_storage_path "$initial_path"

  if [[ -f "$VUEIO_HOME/.installing" && ! -f "$VUEIO_HOME/.installed" ]]; then
    grep -qx 'vueio-install-v1' "$VUEIO_HOME/.installing" ||
      die "Unrecognized incomplete-install marker in $VUEIO_HOME; refusing to remove that directory"
    warn "Removing an incomplete prior installation before retrying."
    if [[ -f $ENV_FILE && -f $COMPOSE_FILE && -f $STORAGE_COMPOSE_FILE ]]; then
      # This volume belongs only to a setup that never reached `.installed`.
      # Leaving it behind makes the safety preflight reject every retry.
      compose down -v --remove-orphans ||
        die "Could not remove the incomplete installation's Docker resources; $VUEIO_HOME was preserved"
    fi
    rm -rf -- "$VUEIO_HOME"
  fi
  [[ ! -e "$ENV_FILE" ]] || die "An installation already exists in $VUEIO_HOME"
  if [[ -d $VUEIO_HOME ]] && find "$VUEIO_HOME" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
    die "Installation directory is not empty: $VUEIO_HOME"
  fi
  if docker ps -aq --filter "label=com.docker.compose.project=$compose_project" | grep -q . ||
    docker network ls -q --filter "label=com.docker.compose.project=$compose_project" | grep -q . ||
    docker volume inspect "$postgres_volume" >/dev/null 2>&1; then
    die "Docker resources already exist for project '$compose_project'. Choose a unique VUEIO_COMPOSE_PROJECT instead of risking another installation."
  fi

  if [[ ${VUEIO_NONINTERACTIVE:-0} != 1 ]]; then
    title "Ready to install"
    note "Web address: $local_url"
    note "Project storage: $initial_path"
    note "Vueio will not receive access to any other host folder."
    confirm "Continue?" || {
      note "Installation cancelled. Nothing was changed."
      return 0
    }
  fi

  step "Creating private configuration"
  mkdir -p "$VUEIO_HOME" "$STORAGE_DIR" "$BACKUP_DIR" "$LOG_DIR" "$VUEIO_HOME/data"
  printf 'vueio-install-v1\n' >"$VUEIO_HOME/.installing"
  # EXIT traps run after Bash has released function-local variables.
  VUEIO_INSTALL_RESOURCES_MAY_EXIST=false
  VUEIO_INSTALL_IN_PROGRESS=true
  VUEIO_INSTALL_CREATED_STORAGE_MARKER=
  VUEIO_INSTALL_CREATED_STORAGE_SENTINEL=
  VUEIO_INSTALL_CREATED_STORAGE_DIR=
  cleanup_failed_install() {
    local status=$? marker_value='' resources_removed=true
    trap - EXIT INT TERM
    set +e
    if [[ -f "$VUEIO_HOME/.installing" ]]; then
      if [[ $VUEIO_INSTALL_RESOURCES_MAY_EXIST == true && -f $ENV_FILE && -f $COMPOSE_FILE && -f $STORAGE_COMPOSE_FILE ]]; then
        compose down -v --remove-orphans >/dev/null 2>&1 || resources_removed=false
      fi
      if [[ $resources_removed != true ]]; then
        warn "Docker cleanup failed; incomplete state was preserved in $VUEIO_HOME for a safe retry."
        exit "$status"
      fi
      if [[ -n ${VUEIO_INSTALL_CREATED_STORAGE_MARKER:-} &&
        -n ${VUEIO_INSTALL_CREATED_STORAGE_SENTINEL:-} &&
        -f $VUEIO_INSTALL_CREATED_STORAGE_MARKER &&
        ! -L $VUEIO_INSTALL_CREATED_STORAGE_MARKER ]]; then
        marker_value=$(
          dd if="$VUEIO_INSTALL_CREATED_STORAGE_MARKER" iflag=nofollow,nonblock bs=256 count=1 status=none 2>/dev/null
        ) || marker_value=
        if [[ $marker_value == "$VUEIO_INSTALL_CREATED_STORAGE_SENTINEL" ]]; then
          rm -f -- "$VUEIO_INSTALL_CREATED_STORAGE_MARKER"
        fi
      fi
      if [[ -n ${VUEIO_INSTALL_CREATED_STORAGE_DIR:-} ]]; then
        rmdir -- "$VUEIO_INSTALL_CREATED_STORAGE_DIR" 2>/dev/null || true
      fi
      rm -rf -- "$VUEIO_HOME"
      warn "Incomplete installation state was removed. Run '$PROGRAM install' to retry."
    fi
    exit "$status"
  }
  trap cleanup_failed_install EXIT INT TERM

  cp "$source_compose" "$COMPOSE_FILE"
  install -m 0644 "$source_license" "$LICENSE_FILE"
  cat >"$ENV_FILE" <<EOF
VUEIO_VERSION=$version
VUEIO_CHANNEL=$channel
VUEIO_COMPOSE_PROJECT=$compose_project
VUEIO_UI_PORT=$port
VUEIO_BIND_ADDRESS=$bind
VUEIO_DATA_PATH=$VUEIO_HOME/data
VUEIO_PUID=$puid
VUEIO_PGID=$pgid
VUEIO_UMASK=${VUEIO_UMASK:-0027}
VUEIO_PROJECT_DIRECTORY_MODE=${VUEIO_PROJECT_DIRECTORY_MODE:-0775}
VUEIO_PROJECT_FILE_MODE=${VUEIO_PROJECT_FILE_MODE:-0664}
VUEIO_UPLOAD_MAX_FILE_BYTES=${VUEIO_UPLOAD_MAX_FILE_BYTES:-107374182400}
VUEIO_UPLOAD_MAX_SESSION_BYTES=${VUEIO_UPLOAD_MAX_SESSION_BYTES:-536870912000}
VUEIO_UPLOAD_MIN_FREE_BYTES=${VUEIO_UPLOAD_MIN_FREE_BYTES:-21474836480}
VUEIO_DATA_MIN_FREE_BYTES=${VUEIO_DATA_MIN_FREE_BYTES:-21474836480}
VUEIO_TRANSCODE_CACHE_MAX_BYTES=${VUEIO_TRANSCODE_CACHE_MAX_BYTES:-268435456000}
VUEIO_POSTGRES_DB=vueio
VUEIO_POSTGRES_USER=vueio
VUEIO_POSTGRES_PASSWORD=$(random_hex 32)
VUEIO_POSTGRES_VOLUME=$postgres_volume
VUEIO_SECRET_KEY=$(random_hex 48)
VUEIO_SETUP_TOKEN=$(random_hex 24)
VUEIO_APP_ENV=production
VUEIO_LOCAL_HTTP=true
VUEIO_SESSION_COOKIE_SECURE=false
VUEIO_CORS_ALLOW_ORIGINS=$local_url
VUEIO_PUBLIC_BASE_URL=
VUEIO_TRUST_CLOUDFLARE=false
VUEIO_TRUST_UPSTREAM_PROXY=false
VUEIO_PROJECT_STORAGE_ROOTS={}
VUEIO_ENGINE_REPOSITORY=${VUEIO_ENGINE_REPOSITORY:-ghcr.io/rfxmedia/vueio-engine}
VUEIO_UI_REPOSITORY=${VUEIO_UI_REPOSITORY:-ghcr.io/rfxmedia/vueio-ui}
VUEIO_RELEASE_ROOT_URL=${VUEIO_RELEASE_ROOT_URL:-https://github.com/rfxmedia/vueio/releases}
VUEIO_UPDATE_REPOSITORY=${VUEIO_UPDATE_REPOSITORY:-rfxmedia/vueio}
VUEIO_ENGINE_IMAGE=${VUEIO_ENGINE_IMAGE:-${VUEIO_ENGINE_REPOSITORY:-ghcr.io/rfxmedia/vueio-engine}:$version}
VUEIO_UI_IMAGE=${VUEIO_UI_IMAGE:-${VUEIO_UI_REPOSITORY:-ghcr.io/rfxmedia/vueio-ui}:$version}
EOF
  chmod 600 "$ENV_FILE"
  chmod 700 "$VUEIO_HOME" "$STORAGE_DIR" "$BACKUP_DIR" "$LOG_DIR"
  chown "$puid:$pgid" "$VUEIO_HOME/data" 2>/dev/null ||
    warn "Could not set data ownership to $puid:$pgid; verify it with '$PROGRAM doctor'"
  render_storage

  if [[ $create_initial_path == true ]]; then
    mkdir -p -- "$initial_path"
    chown "$puid:$pgid" "$initial_path" 2>/dev/null ||
      warn "Could not set project storage ownership to $puid:$pgid"
    VUEIO_INSTALL_CREATED_STORAGE_DIR=$initial_path
    success "Created project storage at $initial_path"
  fi

  storage_add "$initial_label" "$initial_path" "$initial_mode"

  if [[ ${VUEIO_SKIP_START:-0} != 1 ]]; then
    if [[ ${VUEIO_SKIP_PULL:-0} != 1 ]]; then
      step "Downloading Vueio containers"
      compose pull
    fi
    VUEIO_INSTALL_RESOURCES_MAY_EXIST=true
    step "Starting the database and Vueio services"
    compose up -d
    step "Running installation safety checks"
    doctor
  fi
  printf 'vueio-install-v1\n' >"$VUEIO_HOME/.installed"
  rm -f "$VUEIO_HOME/.installing"
  VUEIO_INSTALL_IN_PROGRESS=false
  VUEIO_INSTALL_CREATED_STORAGE_MARKER=
  VUEIO_INSTALL_CREATED_STORAGE_SENTINEL=
  VUEIO_INSTALL_CREATED_STORAGE_DIR=
  trap - EXIT INT TERM
  title "Vueio is ready"
  success "Installation completed successfully"
  printf '\nOpen: %s%s%s\n' "$BOLD" "$local_url" "$RESET"
  printf 'Setup code: %s%s%s\n\n' "$BOLD" "$(env_value VUEIO_SETUP_TOKEN)" "$RESET"
  note "Open the address in a browser and enter the setup code to create the owner account."
  warn "Local HTTP mode is not safe for direct internet exposure."
}

doctor() {
  require_installed
  local fix=false local_http data_path puid pgid id label mode path sentinel marker ui_ready=false
  local version channel engine_image ui_image expected_engine expected_ui probe available_kb
  local -a issues=()
  case ${1:-} in
    '') ;;
    --fix) fix=true ;;
    *) die "Usage: $PROGRAM doctor [--fix]" ;;
  esac

  version=$(env_value VUEIO_VERSION)
  channel=$(env_value VUEIO_CHANNEL)
  channel=${channel:-stable}
  if [[ $fix == true ]]; then
    [[ ! -f $UPDATE_STATE_FILE ]] ||
      die "An interrupted update must recover first. Re-run the same update command."
    note "Applying safe repairs..."
    find "$VUEIO_HOME" -maxdepth 1 -type d \
      \( -name '.update.*' -o -name '.release-check.*' \) \
      -exec rm -rf -- {} +
    if [[ -z $(env_value VUEIO_CHANNEL) ]]; then
      set_env VUEIO_CHANNEL stable
      channel=stable
    fi
    if [[ $version =~ $RELEASE_TAG_PATTERN ]]; then
      expected_engine="$(env_value VUEIO_ENGINE_REPOSITORY):$version"
      expected_ui="$(env_value VUEIO_UI_REPOSITORY):$version"
      set_env VUEIO_ENGINE_IMAGE "$expected_engine"
      set_env VUEIO_UI_IMAGE "$expected_ui"
    fi
    mkdir -p "$BACKUP_DIR" "$LOG_DIR"
    chmod 700 "$BACKUP_DIR" "$LOG_DIR"
    compose up -d
  fi

  note "Vueio release: $(env_value VUEIO_VERSION)"
  note "Update channel: $channel"
  note "Configured origin: $(env_value VUEIO_CORS_ALLOW_ORIGINS)"
  note "Checking Docker configuration..."
  if ! compose config -q; then
    issues+=("Fix the Docker Compose configuration, then run '$PROGRAM doctor' again.")
  fi

  if [[ ! $version =~ $RELEASE_TAG_PATTERN ]]; then
    warn "Installed release tag is invalid: $version"
    issues+=("Restore VUEIO_VERSION to the exact release tag that is installed.")
  fi
  if [[ $channel != stable && $channel != nightly ]]; then
    warn "Update channel is invalid: $channel"
    issues+=("Run '$PROGRAM channel stable' or '$PROGRAM channel nightly'.")
  fi

  engine_image=$(env_value VUEIO_ENGINE_IMAGE)
  ui_image=$(env_value VUEIO_UI_IMAGE)
  expected_engine="$(env_value VUEIO_ENGINE_REPOSITORY):$version"
  expected_ui="$(env_value VUEIO_UI_REPOSITORY):$version"
  if [[ $engine_image != "$expected_engine" || $ui_image != "$expected_ui" ]]; then
    warn "Container image pins do not match the installed release"
    issues+=("Run '$PROGRAM doctor --fix' to reconcile the image pins safely.")
  else
    note "OK: container image pins match $version"
  fi

  if [[ -f $UPDATE_STATE_FILE && ${VUEIO_UPDATE_IN_PROGRESS:-0} != 1 ]]; then
    warn "An incomplete update state is present: $UPDATE_STATE_FILE"
    issues+=("Re-run the same update command so Vueio can recover before retrying.")
  elif [[ -f $UPDATE_STATE_FILE ]]; then
    note "OK: the current update owns its recovery state"
  else
    note "OK: no partial update is waiting for recovery"
  fi

  if [[ -d $BACKUP_DIR ]] && probe=$(mktemp "$BACKUP_DIR/.write-test.XXXXXX" 2>/dev/null); then
    rm -f "$probe"
    note "OK: backup directory is writable"
  else
    warn "Backup directory is not writable: $BACKUP_DIR"
    issues+=("Correct the permissions on $BACKUP_DIR before updating or backing up.")
  fi
  if [[ -d $LOG_DIR ]] && probe=$(mktemp "$LOG_DIR/.write-test.XXXXXX" 2>/dev/null); then
    rm -f "$probe"
    note "OK: update log directory is writable"
  else
    warn "Update log directory is not writable: $LOG_DIR"
    issues+=("Correct the permissions on $LOG_DIR before updating.")
  fi
  available_kb=$(df -Pk "$VUEIO_HOME" | awk 'NR == 2 {print $4}')
  if ((available_kb >= 2 * 1024 * 1024)); then
    note "OK: at least 2 GiB of update headroom is available"
  else
    warn "Less than 2 GiB is free on the Vueio filesystem"
    issues+=("Free at least 2 GiB before downloading an update.")
  fi

  data_path=$(env_value VUEIO_DATA_PATH)
  puid=$(env_value VUEIO_PUID)
  pgid=$(env_value VUEIO_PGID)
  if [[ -d $data_path ]]; then
    note "OK: application data directory exists"
  else
    warn "Application data directory is missing: $data_path"
    issues+=("Restore or recreate the configured application data directory.")
  fi
  while IFS=$'\t' read -r id label path mode sentinel; do
    marker="$path/.vueio-storage-id"
    if [[ ! -d $path ]]; then
      warn "Storage '$label' is unavailable: $path"
      issues+=("Reconnect storage '$label' at $path.")
    elif [[ ! $sentinel =~ ^[a-f0-9]{32,128}$ ]]; then
      warn "Storage '$label' has no valid identity marker recorded; remove and re-add it after preparing $marker"
      issues+=("Remove and re-add storage '$label' after preparing its identity marker.")
    elif [[ -L $marker || ! -f $marker ]]; then
      warn "Storage '$label' is missing its regular identity marker: $marker"
      issues+=("Restore the identity marker for storage '$label'.")
    elif ! storage_marker_matches "$marker" "$sentinel"; then
      warn "Storage '$label' has the wrong mount identity; the expected filesystem may be disconnected"
      issues+=("Reconnect the expected filesystem for storage '$label'.")
    else
      note "OK: storage '$label' is available with the expected mount identity ($mode)"
    fi
  done < <(storage_records)

  local_http=$(env_value VUEIO_LOCAL_HTTP)
  if [[ $local_http == true ]]; then
    warn "Local HTTP bootstrap mode is enabled. Do not expose this port directly to the internet."
  else
    note "OK: secure-cookie/public URL mode is enabled"
  fi

  if compose ps --status running -q vueio_postgres 2>/dev/null | grep -q .; then
    if compose exec -T vueio_postgres pg_isready \
      -U "$(env_value VUEIO_POSTGRES_USER)" \
      -d "$(env_value VUEIO_POSTGRES_DB)" >/dev/null; then
      note "OK: PostgreSQL is responding"
    else
      warn "PostgreSQL is running but not ready"
      issues+=("Run '$PROGRAM doctor --fix' to restart unhealthy services.")
    fi
  else
    warn "PostgreSQL is not running"
    issues+=("Run '$PROGRAM doctor --fix' to start PostgreSQL.")
  fi

  if compose ps --status running -q vueio_engine 2>/dev/null | grep -q .; then
    if compose exec -T vueio_engine python -c \
      "import os,sys; sys.exit(0 if os.access('/app/data', os.R_OK | os.W_OK) else 1)"; then
      note "OK: engine user $puid:$pgid can read and write application data"
    else
      warn "Engine user $puid:$pgid cannot read and write application data"
      issues+=("Correct ownership or permissions on $data_path for $puid:$pgid.")
    fi
    while IFS=$'\t' read -r id label _ mode sentinel; do
      if compose exec -T vueio_engine python -c \
        "import os,sys; from pathlib import Path; p=Path('/storage/root-$id'); s='$sentinel'; m=p/'.vueio-storage-id'; ok=bool(s) and p.is_dir() and os.access(p, os.R_OK) and m.is_file() and not m.is_symlink() and m.read_text().rstrip('\\n')==s; sys.exit(0 if ok else 1)"; then
        if [[ $mode == rw ]] && ! compose exec -T vueio_engine python -c \
          "import os,sys; sys.exit(0 if os.access('/storage/root-$id', os.W_OK) else 1)"; then
          warn "Engine cannot write read/write storage '$label'"
          issues+=("Correct write access for storage '$label'.")
        else
          note "OK: engine can access storage '$label' as $mode"
        fi
      else
        warn "Engine cannot read storage '$label'"
        issues+=("Correct read access for storage '$label'.")
      fi
    done < <(storage_records)
  else
    warn "Vueio engine is not running; container permission checks were skipped"
    issues+=("Run '$PROGRAM doctor --fix' to restart the Vueio engine.")
  fi

  # A newly created UI container can briefly report "running" before Docker
  # accepts exec requests. Give first boot the same bounded readiness window as
  # the Compose health checks instead of treating that startup race as failure.
  for _ in {1..30}; do
    if compose ps --status running -q vueio_ui 2>/dev/null | grep -q . &&
      compose exec -T vueio_ui wget -qO- http://127.0.0.1:8080/api/setup/status >/dev/null 2>&1; then
      ui_ready=true
      break
    fi
    sleep 1
  done
  if [[ $ui_ready == true ]]; then
    note "OK: Vueio UI and API are responding"
  else
    warn "Vueio UI or API did not become ready"
    issues+=("Run '$PROGRAM doctor --fix', then inspect '$PROGRAM logs' if readiness still fails.")
  fi

  if ((${#issues[@]})); then
    warn "${#issues[@]} issue(s) need attention:"
    local issue_number=1 issue
    for issue in "${issues[@]}"; do
      printf '%d. %s\n' "$issue_number" "$issue" >&2
      issue_number=$((issue_number + 1))
    done
    die "Vueio needs attention"
  fi
  success "Everything looks healthy."
}

backup_manifest_value() {
  local archive=$1 key=$2
  tar -xOzf "$archive" ./manifest 2>/dev/null |
    sed -n "s/^${key}=//p" |
    tail -n 1
}

prune_backups() {
  local keep=${VUEIO_BACKUP_KEEP:-5} latest_pre_update='' archive kept=0
  local -a archives=()
  [[ $keep =~ ^[1-9][0-9]*$ ]] || die "VUEIO_BACKUP_KEEP must be a positive number"
  mapfile -t archives < <(
    find "$BACKUP_DIR" -maxdepth 1 -type f -name '*.tar.gz' -printf '%T@\t%p\n' |
      sort -rn |
      cut -f2-
  )
  for archive in "${archives[@]}"; do
    if [[ ${archive##*/} == pre-update-* ]]; then
      latest_pre_update=$archive
      break
    fi
  done
  for archive in "${archives[@]}"; do
    if ((kept < keep)) || [[ -n $latest_pre_update && $archive == "$latest_pre_update" ]]; then
      kept=$((kept + 1))
      continue
    fi
    rm -f -- "$archive" "$archive.sha256"
  done
}

list_backups() {
  require_installed
  local archive version created kind size found=false
  local -a archives=()
  mapfile -t archives < <(
    find "$BACKUP_DIR" -maxdepth 1 -type f -name '*.tar.gz' -printf '%T@\t%p\n' |
      sort -rn |
      cut -f2-
  )
  printf '%-18s  %-26s  %-12s  %9s\n' CREATED VERSION TYPE SIZE
  for archive in "${archives[@]}"; do
    version=$(backup_manifest_value "$archive" version)
    created=$(backup_manifest_value "$archive" created_at)
    kind=$(backup_manifest_value "$archive" kind)
    size=$(du -h "$archive" | awk '{print $1}')
    [[ -n $version && -n $created ]] || continue
    found=true
    printf '%-18s  %-26s  %-12s  %9s\n' "$created" "$version" "${kind:-manual}" "$size"
  done
  [[ $found == true ]] || note "(no backups available)"
}

backup_vueio() (
  set -Eeuo pipefail
  umask 077
  require_installed
  local destination=${1:-} stamp tmp archive_tmp='' checksum_tmp='' was_running=false
  local kind=${VUEIO_BACKUP_KIND:-manual} target_version=${VUEIO_BACKUP_TARGET_VERSION:-}
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  destination=${destination:-"$BACKUP_DIR/vueio-$stamp.tar.gz"}
  [[ $destination = /* ]] || destination="$(pwd)/$destination"
  [[ ! -d $destination ]] || die "Backup destination is a directory: $destination"
  mkdir -p "$(dirname "$destination")"
  archive_tmp=$(mktemp "$(dirname "$destination")/.vueio-backup.XXXXXX")
  checksum_tmp=$(mktemp "$(dirname "$destination")/.vueio-checksum.XXXXXX") || {
    rm -f -- "$archive_tmp"
    die "Could not create the backup checksum"
  }
  tmp=$(mktemp -d "$VUEIO_HOME/.backup.XXXXXX") || {
    rm -f -- "$archive_tmp" "$checksum_tmp"
    die "Could not create backup staging"
  }
  trap 'rm -rf "$tmp"; rm -f -- "${archive_tmp:-}" "${checksum_tmp:-}"; if [[ $was_running == true ]]; then compose start vueio_engine >/dev/null 2>&1 || true; fi' EXIT INT TERM

  if compose ps --status running -q vueio_engine 2>/dev/null | grep -q .; then
    was_running=true
    compose stop vueio_engine >/dev/null
  fi
  compose exec -T vueio_postgres pg_dump \
    -U "$(env_value VUEIO_POSTGRES_USER)" \
    -d "$(env_value VUEIO_POSTGRES_DB)" \
    -Fc >"$tmp/database.dump"
  [[ -s "$tmp/database.dump" ]] || die "PostgreSQL produced an empty backup"
  compose exec -T vueio_postgres pg_restore --list <"$tmp/database.dump" >/dev/null ||
    die "PostgreSQL backup validation failed"
  cp "$ENV_FILE" "$tmp/environment"
  cp "$COMPOSE_FILE" "$STORAGE_COMPOSE_FILE" "$tmp/"
  cp -a "$STORAGE_DIR" "$tmp/storage.d"
  mkdir "$tmp/data"
  tar -C "$(env_value VUEIO_DATA_PATH)" \
    --hard-dereference \
    --exclude='./cache' \
    --exclude='./packages/tmp' \
    -cf - . |
    tar -C "$tmp/data" -xf -
  {
    printf 'format=1\n'
    printf 'created_at=%s\n' "$stamp"
    printf 'version=%s\n' "$(env_value VUEIO_VERSION)"
    printf 'kind=%s\n' "$kind"
    printf 'target_version=%s\n' "$target_version"
    printf 'scope=database,application-data,configuration-reference\n'
    printf 'source_media_included=false\n'
    printf 'rebuildable_cache_included=false\n'
  } >"$tmp/manifest"
  python3 - "$tmp" <<'PY' || die "Application data contains entries that cannot be restored safely"
import os
import pathlib
import stat
import sys

root = pathlib.Path(sys.argv[1])
entry_count = 0
total_bytes = 0
try:
    for directory, subdirectories, filenames in os.walk(root, followlinks=False):
        for name in [*subdirectories, *filenames]:
            entry_count += 1
            # The final archive also contains its root and checksum manifest.
            if entry_count > 99_998:
                raise ValueError('member limit')
            relative = (pathlib.Path(directory, name).relative_to(root)).as_posix()
            encoded = relative.encode('utf-8', errors='surrogateescape')
            if (
                len(encoded) > 4096
                or '\\' in relative
                or any(ord(character) < 32 or ord(character) == 127 for character in relative)
                or any(
                    len(part.encode('utf-8', errors='surrogateescape')) > 255
                    for part in relative.split('/')
                )
            ):
                raise ValueError('unsafe path')
            entry = os.lstat(root / relative)
            if stat.S_ISREG(entry.st_mode):
                total_bytes += entry.st_size
                if total_bytes > 2 * 1024 * 1024 * 1024 * 1024:
                    raise ValueError('expanded size limit')
            elif not stat.S_ISDIR(entry.st_mode):
                raise ValueError('link or special entry')
except Exception:
    raise SystemExit(1)
PY
  (
    cd "$tmp"
    # The destination is excluded explicitly; redirection creates it before find runs.
    # shellcheck disable=SC2094
    find . -type f ! -name checksums.sha256 -print0 |
      sort -z |
      xargs -0 sha256sum >checksums.sha256
  )
  tar --hard-dereference -C "$tmp" -czf "$archive_tmp" .
  sha256sum "$archive_tmp" |
    sed "s#  .*#  $(basename "$destination")#" >"$checksum_tmp"
  mv -f -- "$archive_tmp" "$destination"
  archive_tmp=
  mv -f -- "$checksum_tmp" "$destination.sha256"
  checksum_tmp=
  if [[ $was_running == true ]]; then
    if [[ ${VUEIO_BACKUP_LEAVE_ENGINE_STOPPED:-0} != 1 ]]; then
      compose start vueio_engine >/dev/null
      wait_for_engine || die "Vueio engine did not become ready after the backup"
    fi
    was_running=false
  fi
  trap - EXIT INT TERM
  rm -rf "$tmp"
  note "Backup created: $destination"
  note "Checksum created: $destination.sha256"
  warn "Original project media is not included; back up storage roots separately."
  case "$destination" in
    "$BACKUP_DIR"/*) prune_backups ;;
  esac
)

restore_vueio() (
  set -Eeuo pipefail
  umask 077
  require_installed
  require_command python3
  local archive=${1:-} source_archive confirmation tmp safety data_path data_parent staged_data='' old_data stamp
  local safety_db required_kb available_kb archive_bytes engine_stopped=false old_data_moved=false db_restored=false
  [[ -f $archive ]] || die "Usage: $PROGRAM restore <archive.tar.gz>"
  if [[ ${VUEIO_NONINTERACTIVE:-0} != 1 ]]; then
    printf 'Restore this backup and replace current Vueio state? Type RESTORE: '
    read -r confirmation
    [[ $confirmation == RESTORE ]] || return 0
  elif [[ ${VUEIO_RESTORE_CONFIRM:-} != RESTORE ]]; then
    die "Set VUEIO_RESTORE_CONFIRM=RESTORE for a non-interactive restore"
  fi

  source_archive=$(cd -P -- "$(dirname -- "$archive")" && pwd)/$(basename -- "$archive")
  tmp=$(mktemp -d "$VUEIO_HOME/.restore.XXXXXX")
  trap 'rm -rf "$tmp"; [[ -z ${staged_data:-} ]] || rm -rf -- "$staged_data"; if [[ $engine_stopped == true ]]; then compose start vueio_engine >/dev/null 2>&1 || true; fi' EXIT INT TERM
  archive="$tmp/input.tar.gz"
  cp -- "$source_archive" "$archive"
  chmod 0600 "$archive"
  if [[ -f "$source_archive.sha256" ]]; then
    if ! python3 - "$archive" "$source_archive.sha256" "$(basename -- "$source_archive")" <<'PY'
import hashlib
import pathlib
import re
import sys

archive = pathlib.Path(sys.argv[1])
checksum = pathlib.Path(sys.argv[2])
expected_name = sys.argv[3]
try:
    if checksum.stat().st_size > 4096:
        raise ValueError('oversized checksum file')
    lines = [line for line in checksum.read_text(encoding='utf-8').splitlines() if line]
    if len(lines) != 1:
        raise ValueError('invalid checksum file')
    match = re.fullmatch(r'([0-9a-fA-F]{64}) [ *](.+)', lines[0])
    if not match or match.group(2) != expected_name:
        raise ValueError('checksum target mismatch')
    digest = hashlib.sha256()
    with archive.open('rb') as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b''):
            digest.update(chunk)
    if not __import__('hmac').compare_digest(digest.hexdigest(), match.group(1).lower()):
        raise ValueError('checksum mismatch')
except Exception:
    raise SystemExit(1)
PY
    then
      die "Backup archive checksum failed"
    fi
  else
    warn "No adjacent archive checksum was found; validating internal contents only"
  fi
  archive_bytes=$(python3 - "$archive" <<'PY'
import posixpath
import sys
import tarfile

allowed_files = {
    'checksums.sha256',
    'compose.storage.yml',
    'compose.yml',
    'database.dump',
    'environment',
    'manifest',
}
